---
import { rubrikBySlug } from '../data/site.js';
import { formatDate } from '../data/articles.js';

interface Props {
  article: any;
  variant?: 'standard' | 'horizontal' | 'compact' | 'number' | 'portrait' | 'minimal';
  index?: number;
  tone?: 'light' | 'dark';
}

const { article, variant = 'standard', index, tone = 'light' } = Astro.props;
const r = rubrikBySlug[article.rubrik];
const href = `/tulisan/${article.slug}`;
---

<a href={href} class:list={['card', `card--${variant}`, `card--${tone}`]} aria-label={article.title}>
  {variant !== 'minimal' && variant !== 'number' && (
    <div class="card__media">
      <img src={article.image} alt={article.imageAlt} loading="lazy" decoding="async" />
      <span class="card__rubrik">{r.name}</span>
    </div>
  )}

  <div class="card__body">
    {variant === 'number' && (
      <span class="card__num">{String(index).padStart(2, '0')}</span>
    )}
    {variant === 'minimal' && <span class="card__kicker">{r.name}</span>}

    <h3 class="card__title">{article.title}</h3>

    {(variant === 'standard' || variant === 'horizontal' || variant === 'portrait') && (
      <p class="card__dek">{article.dek}</p>
    )}

    <div class="card__meta">
      <span class="card__author">{article.author}</span>
      <span class="card__dot"></span>
      <time datetime={article.date}>{formatDate(article.date)}</time>
      <span class="card__dot"></span>
      <span>{article.reading} mnt baca</span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    color: var(--ink);
  }
  .card--dark { color: var(--paper); }

  /* ── media ── */
  .card__media {
    position: relative;
    overflow: hidden;
    background: var(--ink-2);
    aspect-ratio: 4 / 3;
  }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out), filter 1s var(--ease);
    filter: saturate(0.92);
  }
  .card:hover .card__media img {
    transform: scale(1.045);
    filter: saturate(1);
  }
  .card__rubrik {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.5rem 0.85rem;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .card--dark .card__rubrik { background: var(--gold-600); color: var(--ink); }

  /* ── body ── */
  .card__body { display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }

  .card__title {
    font-family: var(--serif-display);
    font-size: clamp(1.25rem, 1.9vw, 1.6rem);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.012em;
    transition: color 0.35s var(--ease);
  }
  .card:hover .card__title { color: var(--gold-700); }
  .card--dark:hover .card__title { color: var(--gold-200); }

  .card__dek {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card--dark .card__dek { color: rgba(244, 239, 228, 0.58); }

  .card__meta {
    margin-top: auto;
    padding-top: 0.35rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sans);
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .card--dark .card__meta { color: rgba(244, 239, 228, 0.46); }
  .card__author { color: var(--ink-soft); }
  .card--dark .card__author { color: rgba(244, 239, 228, 0.68); }
  .card__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }

  .card__kicker {
    font-family: var(--sans);
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-700);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line);
  }
  .card__num {
    font-family: var(--serif-display);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    line-height: 1;
    color: var(--gold);
    font-style: italic;
  }

  /* ── varian ── */
  .card--horizontal {
    flex-direction: row;
    align-items: flex-start;
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  .card--horizontal .card__media {
    width: clamp(140px, 32%, 320px);
    flex: none;
    aspect-ratio: 4 / 3;
  }
  .card--horizontal .card__title { font-size: clamp(1.15rem, 1.7vw, 1.4rem); }

  .card--compact { gap: 0.7rem; }
  .card--compact .card__media { aspect-ratio: 16 / 10; }
  .card--compact .card__title { font-size: 1.1rem; line-height: 1.2; }
  .card--compact .card__meta { font-size: 0.55rem; letter-spacing: 0.1em; }

  .card--number { gap: 0.55rem; }
  .card--number .card__title { font-size: clamp(1.1rem, 1.5vw, 1.3rem); }

  .card--portrait .card__media { aspect-ratio: 3 / 4; }
  .card--portrait .card__title { font-size: clamp(1.15rem, 1.6vw, 1.45rem); }

  .card--minimal { gap: 0.5rem; }
  .card--minimal .card__title {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.2;
  }
  .card--minimal .card__meta { padding-top: 0.15rem; }

  @media (max-width: 560px) {
    .card--horizontal { flex-direction: column; }
    .card--horizontal .card__media { width: 100%; }
  }
</style>
