---
import { byRubrik, formatDate } from '../data/articles.js';
import AdSlot from './AdSlot.astro';
const posts = byRubrik('kronik');
---
<section class="kb">
  <div class="wrap">
    <div class="kb__head">
      <div class="kb__left">
        <span class="kb__index">01</span>
        <div>
          <span class="eyebrow">Kronik</span>
          <h2 class="kb__title">Peristiwa yang <em>menolak</em> dilupakan</h2>
        </div>
      </div>
      <a href="/rubrik/kronik" class="kb__link">Semua kronik <span>→</span></a>
    </div>

    <div class="kb__grid">
      {posts.map((a, i) => (
        <a href={`/tulisan/${a.slug}`} class="kb__card" data-reveal style={`--d:${i * 0.07}s`}>
          <div class="kb__media">
            <img src={a.image} alt={a.imageAlt} loading="lazy" />
          </div>
          <div class="kb__meta">
            <span class="kb__date">{formatDate(a.date)}</span>
            <span class="kb__dot"></span>
            <span>{a.reading} mnt baca</span>
          </div>
          <h3 class="kb__ctitle">{a.title}</h3>
          <p class="kb__dek">{a.dek}</p>
          <span class="kb__author">{a.author}</span>
        </a>
      ))}
      <div class="kb__quote">
        <span class="kb__qmark" aria-hidden="true">“</span>
        <p>Sejarah tidak hilang sekaligus. Ia menipis, lapis demi lapis, sampai
        hanya tersisa suara orang-orang yang masih mau mengulangnya.</p>
        <span class="kb__qcite">Catatan redaksi Kronik</span>
      </div>
      <div class="kb__ad">
        <AdSlot format="compact" />
      </div>
    </div>
  </div>
</section>

<style>
  .kb {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .kb__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--ink);
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .kb__left { display: flex; align-items: baseline; gap: 1rem; }
  .kb__index {
    font-family: var(--serif-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--gold-600);
  }
  .kb__title {
    font-family: var(--serif-display);
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 400;
    letter-spacing: -0.018em;
    margin-top: 0.4rem;
    line-height: 1.05;
  }
  .kb__title em { font-style: italic; color: var(--gold-700); }
  .kb__link {
    font-family: var(--sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    white-space: nowrap;
    padding-bottom: 0.3rem;
    transition: color 0.3s;
  }
  .kb__link:hover { color: var(--ink); }
  .kb__link span { transition: transform 0.4s var(--ease-out); }
  .kb__link:hover span { transform: translateX(4px); }

  .kb__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    align-items: start;
  }
  .kb__card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .kb__media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--ink-2);
    margin-bottom: 0.35rem;
  }
  .kb__card:first-child .kb__media { aspect-ratio: 16 / 11; }
  .kb__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: transform 1.4s var(--ease-out), filter 0.7s;
  }
  .kb__card:hover .kb__media img { transform: scale(1.045); filter: saturate(1); }
  .kb__meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--sans);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-700);
  }
  .kb__dot { width: 3px; height: 3px; border-radius: 50%; background: var(--line); }
  .kb__ctitle {
    font-family: var(--serif-display);
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.012em;
    transition: color 0.35s;
  }
  .kb__card:first-child .kb__ctitle { font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .kb__card:hover .kb__ctitle { color: var(--gold-700); }
  .kb__dek {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .kb__author {
    font-family: var(--sans);
    font-size: 0.56rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-top: auto;
    padding-top: 0.3rem;
  }
  .kb__quote {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.1rem, 2vw, 1.5rem);
    background: var(--paper-2);
    border-top: 2px solid var(--gold-600);
    align-self: stretch;
  }
  .kb__qmark {
    font-family: var(--serif-display);
    font-size: 2.6rem;
    line-height: 0.6;
    color: var(--gold);
    height: 1.1rem;
  }
  .kb__quote p {
    font-family: var(--serif-display);
    font-style: italic;
    font-size: clamp(0.95rem, 1.3vw, 1.08rem);
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .kb__qcite {
    margin-top: auto;
    padding-top: 0.6rem;
    font-family: var(--sans);
    font-size: 0.52rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-700);
  }
  .kb__ad { grid-column: 1 / -1; margin-top: 0.75rem; }

  @media (max-width: 900px) {
    .kb__grid { grid-template-columns: 1fr 1fr; }
    .kb__card:first-child { grid-column: 1 / -1; }
    .kb__card:first-child .kb__media { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 560px) {
    .kb__grid { grid-template-columns: 1fr; }
    .kb__head { flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  }
</style>
