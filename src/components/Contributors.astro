---
const people = [
  { name: 'Saraswati Dewi', role: 'Pemimpin Redaksi', field: 'Esai & Kritik Sastra', initials: 'SD' },
  { name: 'Nurul Hakim', role: 'Redaktur Kronik', field: 'Sejarah Lisan & Kota', initials: 'NH' },
  { name: 'Dr. Hendra Wicaksono', role: 'Redaktur Khazanah', field: 'Arkeologi & Warisan', initials: 'HW' },
  { name: 'Anindita Kusuma', role: 'Kritikus Seni', field: 'Seni Rupa & Kurasi', initials: 'AK' },
  { name: 'Lestari Anggraini', role: 'Kontributor Humaniora', field: 'Antropologi Migrasi', initials: 'LA' },
  { name: 'Rangga Prasetya', role: 'Redaktur Pelaksana', field: 'Arsip & Dokumentasi', initials: 'RP' },
];
---
<section class="ct">
  <div class="wrap">
    <div class="ct__head">
      <div>
        <span class="eyebrow">Di Balik Halaman</span>
        <h2 class="ct__title">Mereka yang <em>Menulis</em></h2>
      </div>
      <p class="ct__desc">
        Enam editor dan kontributor tetap, bersama lebih dari empat puluh penulis tamu
        dari berbagai disiplin—sejarah, filsafat, antropologi, seni, dan sastra.
      </p>
    </div>

    <div class="ct__grid">
      {people.map((p, i) => (
        <article class="ct__card" data-reveal style={`--d:${i * 0.05}s`}>
          <div class="ct__avatar" aria-hidden="true">{p.initials}</div>
          <h3 class="ct__name">{p.name}</h3>
          <span class="ct__role">{p.role}</span>
          <span class="ct__field">{p.field}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ct {
    padding-block: clamp(3rem, 6vw, 5.5rem);
    border-top: 1px solid var(--line);
  }
  .ct__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .ct__title {
    font-family: var(--serif-display);
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-top: 0.6rem;
  }
  .ct__title em { font-style: italic; color: var(--gold-700); }
  .ct__desc {
    font-size: 0.94rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .ct__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .ct__card {
    background: var(--paper);
    padding: clamp(1.1rem, 2vw, 1.6rem) clamp(0.9rem, 1.6vw, 1.3rem);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    transition: background 0.4s var(--ease);
  }
  .ct__card:hover { background: var(--paper-2); }
  .ct__avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--gold);
    color: var(--gold-700);
    display: grid;
    place-items: center;
    font-family: var(--serif-display);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    margin-bottom: 0.9rem;
    background: radial-gradient(circle at 30% 25%, rgba(208, 175, 98, 0.18), transparent 70%);
    transition: background 0.4s, color 0.4s;
  }
  .ct__card:hover .ct__avatar {
    background: var(--gold);
    color: var(--ivory);
    border-color: var(--gold-600);
  }
  .ct__name {
    font-family: var(--serif-display);
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .ct__role {
    font-family: var(--sans);
    font-size: 0.53rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-700);
    margin-top: 0.15rem;
  }
  .ct__field {
    font-size: 0.78rem;
    color: var(--muted-2);
    line-height: 1.4;
  }

  @media (max-width: 1100px) { .ct__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px) { .ct__head { grid-template-columns: 1fr; align-items: start; } }
  @media (max-width: 620px) { .ct__grid { grid-template-columns: repeat(2, 1fr); } }
</style>
