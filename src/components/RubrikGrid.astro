---
import { rubrik } from '../data/site.js';
import { byRubrik } from '../data/articles.js';
---
<div class="rg">
  {rubrik.map((r) => {
    const count = byRubrik(r.slug).length;
    const first = byRubrik(r.slug)[0];
    return (
      <a href={`/rubrik/${r.slug}`} class="rg__card" data-reveal>
        <span class="rg__index">{r.index}</span>
        <div class="rg__content">
          <h3 class="rg__name">{r.name}</h3>
          <p class="rg__tag">{r.tagline}</p>
          <span class="rg__meta">{count} tulisan</span>
        </div>
        <div class="rg__hover">
          <span class="rg__hover-label">Masuk rubrik</span>
          <span class="rg__arrow">→</span>
        </div>
        {first && (
          <div class="rg__peek" aria-hidden="true">
            <img src={first.image} alt="" loading="lazy" />
          </div>
        )}
      </a>
    );
  })}
</div>

<style>
  .rg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
  }
  .rg__card {
    position: relative;
    background: var(--paper-2);
    padding: clamp(1.4rem, 2.6vw, 2.2rem);
    min-height: 220px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: background 0.5s var(--ease);
  }
  .rg__card:hover { background: var(--ink); }
  .rg__index {
    font-family: var(--sans);
    font-size: 0.55rem;
    letter-spacing: 0.24em;
    color: var(--gold-700);
    transition: color 0.4s;
  }
  .rg__card:hover .rg__index { color: var(--gold-200); }
  .rg__content { margin-top: auto; position: relative; z-index: 2; }
  .rg__name {
    font-family: var(--serif-display);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.4s;
  }
  .rg__card:hover .rg__name { color: var(--paper); }
  .rg__tag {
    font-style: italic;
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 0.35rem;
    max-width: 26ch;
    transition: color 0.4s;
  }
  .rg__card:hover .rg__tag { color: rgba(244, 239, 228, 0.6); }
  .rg__meta {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--sans);
    font-size: 0.53rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-2);
    transition: color 0.4s;
  }
  .rg__card:hover .rg__meta { color: var(--gold-200); }

  .rg__hover {
    position: absolute;
    top: clamp(1.4rem, 2.6vw, 2.2rem);
    right: clamp(1.4rem, 2.6vw, 2.2rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sans);
    font-size: 0.52rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-200);
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.4s, transform 0.5s var(--ease-out);
    z-index: 3;
  }
  .rg__card:hover .rg__hover { opacity: 1; transform: none; }
  .rg__arrow { transition: transform 0.4s var(--ease-out); }
  .rg__card:hover .rg__arrow { transform: translateX(4px); }

  .rg__peek {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.7s var(--ease);
  }
  .rg__peek img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.4) brightness(0.42);
    transition: transform 1.8s var(--ease-out);
  }
  .rg__card:hover .rg__peek { opacity: 0.5; }
  .rg__card:hover .rg__peek img { transform: scale(1.06); }

  @media (max-width: 900px) {
    .rg { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .rg { grid-template-columns: 1fr; }
    .rg__card { min-height: 170px; }
  }
</style>
