---
// Sepotong kalimat — jeda visual yang memberi napas.
---
<section class="qb">
  <div class="qb__bg" data-parallax="0.08" aria-hidden="true">
    <img src="/img/seni-brush.jpg" alt="" loading="lazy" />
  </div>
  <div class="wrap qb__inner">
    <span class="qb__mark" aria-hidden="true">“</span>
    <blockquote class="qb__quote" data-reveal>
      Kebudayaan bukan yang kita warisi. Ia yang kita <em>pilih</em> untuk diwariskan.
    </blockquote>
    <cite class="qb__cite" data-reveal style="--d:.12s">
      — Catatan editor, Edisi No. 84
    </cite>
  </div>
</section>

<style>
  .qb {
    position: relative;
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .qb__bg {
    position: absolute;
    inset: -20%;
    opacity: 0.16;
    will-change: transform;
  }
  .qb__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.6);
  }
  .qb__inner {
    position: relative;
    text-align: center;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .qb__mark {
    font-family: var(--serif-display);
    font-size: clamp(4rem, 10vw, 7rem);
    line-height: 0.4;
    color: var(--gold-600);
    opacity: 0.85;
    margin-bottom: 1.5rem;
  }
  .qb__quote {
    font-family: var(--serif-display);
    font-size: clamp(1.75rem, 4.4vw, 3.4rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .qb__quote em {
    font-style: italic;
    color: var(--gold-200);
  }
  .qb__cite {
    margin-top: 1.75rem;
    font-family: var(--sans);
    font-size: 0.62rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(244, 239, 228, 0.45);
    font-style: normal;
  }
</style>
