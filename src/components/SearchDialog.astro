---
import { articles, formatDate } from '../data/articles.js';
import { rubrikBySlug } from '../data/site.js';
const index = articles.map((a) => ({
  title: a.title,
  dek: a.dek,
  slug: a.slug,
  rubrik: rubrikBySlug[a.rubrik].name,
  author: a.author,
  date: formatDate(a.date),
  tags: a.tags,
  text: (a.title + ' ' + a.dek + ' ' + a.sujudul + ' ' + a.tags.join(' ')).toLowerCase(),
}));
---

<div class="search" id="search-dialog" role="dialog" aria-modal="true" aria-label="Pencarian" hidden>
  <button class="search__backdrop" id="search-backdrop" aria-label="Tutup pencarian"></button>
  <div class="search__panel">
    <div class="search__bar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m16.5 16.5 4 4"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Cari tulisan, penulis, atau gagasan…"
        autocomplete="off"
        aria-label="Kata kunci"
      />
      <button class="search__close" id="search-close" aria-label="Tutup">Esc</button>
    </div>
    <div class="search__hint">
      <span>Contoh:</span>
      <button data-q="kota">kota</button>
      <button data-q="ingatan">ingatan</button>
      <button data-q="arsitektur">arsitektur</button>
      <button data-q="bahasa">bahasa</button>
    </div>
    <div class="search__results" id="search-results" aria-live="polite"></div>
  </div>
</div>

<script type="application/json" id="search-index" set:html={JSON.stringify(index)}></script>

<style>
  .search {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1rem, 8vh, 6rem) 1rem;
  }
  .search[hidden] { display: none; }
  .search__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 18, 15, 0.72);
    backdrop-filter: blur(6px);
    border: 0;
    cursor: pointer;
    animation: fade 0.3s var(--ease);
  }
  @keyframes fade { from { opacity: 0; } }

  .search__panel {
    position: relative;
    width: min(760px, 100%);
    background: var(--paper);
    box-shadow: var(--shadow-lg);
    animation: rise 0.45s var(--ease-out);
    max-height: 80vh;
    display: flex;
    flex-direction: column;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
  }
  .search__bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid var(--line);
  }
  .search__bar svg { width: 20px; height: 20px; flex: none; color: var(--gold-700); }
  .search__bar input {
    flex: 1;
    border: 0;
    background: none;
    font-family: var(--serif-body);
    font-size: 1.1rem;
    padding: 0.2rem 0;
    min-width: 0;
  }
  .search__bar input:focus { outline: none; }
  .search__bar input::placeholder { color: var(--muted-2); font-style: italic; }
  .search__close {
    font-family: var(--sans);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-2);
    background: none;
    border: 1px solid var(--line);
    padding: 0.35em 0.6em;
    cursor: pointer;
    transition: color 0.3s, border-color 0.3s;
  }
  .search__close:hover { color: var(--ink); border-color: var(--gold-600); }

  .search__hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.4rem;
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--sans);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .search__hint button {
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    color: var(--gold-700);
    cursor: pointer;
    padding: 0 0 1px;
    font-size: inherit;
    letter-spacing: 0.1em;
    text-transform: none;
    transition: color 0.25s, border-color 0.25s;
  }
  .search__hint button:hover { color: var(--ink); border-color: var(--ink); }

  .search__results { overflow-y: auto; padding: 0.4rem 0 0.8rem; }
  .search__results:empty::after {
    content: 'Mulai mengetik untuk mencari di seluruh arsip.';
    display: block;
    padding: 2.2rem 1.4rem;
    text-align: center;
    font-family: var(--serif-body);
    font-style: italic;
    color: var(--muted-2);
  }
</style>
