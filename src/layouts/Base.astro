---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgressRail from '../components/ProgressRail.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { site } from '../data/site.js';

interface Props {
  title: string;
  description?: string;
  image?: string;
  bodyClass?: string;
  article?: boolean;
  noRail?: boolean;
}

const {
  title,
  description = site.description,
  image = '/img/hero-kronik.jpg',
  bodyClass = '',
  article = false,
  noRail = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://swarabestari.id');
const ogImage = new URL(image, Astro.site ?? 'https://swarabestari.id');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title === site.name ? title : `${title} — ${site.name}`}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#14120f" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/bodoni-moda-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spectral-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jost-var.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': article ? 'NewsArticle' : 'WebSite',
      name: site.name,
      headline: article ? title : undefined,
      description,
      url: canonical.href,
      publisher: {
        '@type': 'Organization',
        name: site.name,
        logo: new URL('/logo-ink.png', Astro.site ?? 'https://swarabestari.id').href,
      },
    })} />
  </head>
  <body class={`grain ${bodyClass}`}>
    <a class="skip" href="#utama">Lompat ke isi</a>
    {!noRail && <ProgressRail />}
    <Header />
    <main id="utama" class:list={[{ 'main--article': article }]}>
      <slot />
    </main>
    <Footer />
    <SearchDialog />
    <script src="../scripts/app.ts"></script>
  </body>
</html>

<style is:global>
  .main--article {
    background: var(--paper);
  }
</style>
