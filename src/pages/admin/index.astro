---
// Dashboard Admin — halaman murni klien; semua data lewat /api/admin.
import '../../styles/global.css';

const SITE = 'Swara Bestari';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Dashboard — {SITE}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="adm">
    <!-- ═══════════ GERBANG MASUK ═══════════ -->
    <div class="gate" id="gate" hidden>
      <div class="gate__card">
        <div class="gate__brand">
          <img src="/logo-ink.png" alt="" width="52" height="58" />
          <div>
            <span class="gate__name">Swara Bestari</span>
            <span class="gate__sub">Ruang Kerja Redaksi</span>
          </div>
        </div>
        <h1 class="gate__title">Masuk ke dashboard</h1>
        <p class="gate__desc">
          Kelola artikel, ruang iklan, dan pengaturan situs dari sini.
        </p>
        <form id="login-form" class="gate__form">
          <label class="fld">
            <span class="fld__label">Kata sandi</span>
            <input type="password" id="login-pass" autocomplete="current-password" required />
          </label>
          <button class="btn btn--gold" type="submit" id="login-btn">Masuk</button>
          <p class="gate__err" id="login-err" hidden></p>
        </form>
        <p class="gate__foot">
          Belum diatur? Isi <code>ADMIN_PASSWORD</code> di Environment Variables Vercel.
        </p>
      </div>
    </div>

    <!-- ═══════════ APLIKASI ═══════════ -->
    <div class="app" id="app" hidden>
      <aside class="side">
        <div class="side__brand">
          <img src="/logo-ink.png" alt="" width="34" height="38" />
          <div>
            <span class="side__name">Swara Bestari</span>
            <span class="side__sub">Dashboard</span>
          </div>
        </div>

        <nav class="side__nav" id="side-nav">
          <button class="snav is-on" data-view="overview">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13h8V3H3zM13 21h8V11h-8zM3 21h8v-6H3zM13 9h8V3h-8z"/></svg>
            Ikhtisar
          </button>
          <button class="snav" data-view="articles">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM8 9h8M8 13h8M8 17h5"/></svg>
            Artikel
            <span class="snav__count" id="count-articles">0</span>
          </button>
          <button class="snav" data-view="ads">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3zM7 10h6M7 14h4"/></svg>
            Ruang Iklan
          </button>
          <button class="snav" data-view="stats">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
            Statistik
          </button>
          <button class="snav" data-view="settings">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg>
            Pengaturan
          </button>
        </nav>

        <div class="side__foot">
          <a class="side__link" href="/" target="_blank" rel="noopener">Lihat situs ↗</a>
          <button class="side__link" id="logout-btn">Keluar</button>
        </div>
      </aside>

      <main class="main" id="main">
        <!-- ═══ IKHTISAR ═══ -->
        <section class="view" data-view="overview">
          <header class="vh">
            <div>
              <span class="eyebrow">Ruang Kerja</span>
              <h1 class="vh__title">Selamat datang kembali</h1>
            </div>
            <div class="vh__actions">
              <button class="btn btn--ghost" id="publish-btn">Terbitkan ulang situs</button>
              <button class="btn btn--gold" id="new-article-btn">+ Artikel baru</button>
            </div>
          </header>

          <div class="cards" id="kpi-cards"></div>

          <div class="grid2">
            <div class="panel">
              <div class="panel__h">
                <h2 class="panel__t">Kunjungan 14 hari terakhir</h2>
                <span class="panel__meta">Pembaca harian</span>
              </div>
              <div class="spark" id="spark"></div>
              <div class="spark__legend" id="spark-legend"></div>
            </div>

            <div class="panel">
              <div class="panel__h">
                <h2 class="panel__t">Rubrik terkuat</h2>
                <span class="panel__meta">Per artikel</span>
              </div>
              <ul class="bars" id="rubrik-bars"></ul>
            </div>
          </div>

          <div class="panel">
            <div class="panel__h">
              <h2 class="panel__t">Tulisan terbaru</h2>
              <button class="panel__link" data-goto="articles">Kelola semua →</button>
            </div>
            <div class="tblwrap">
              <table class="tbl">
                <thead>
                  <tr><th>Judul</th><th>Rubrik</th><th>Tanggal</th><th>Baca</th><th></th></tr>
                </thead>
                <tbody id="recent-rows"></tbody>
              </table>
            </div>
          </div>

          <div class="panel" id="diag-panel">
            <div class="panel__h">
              <h2 class="panel__t">Kesiapan sistem</h2>
              <button class="panel__link" id="diag-btn">Periksa ulang</button>
            </div>
            <div id="diag-body">
              <p style="color:#8b8272;font-size:.86rem;margin:0">
                Memeriksa sambungan GitHub…
              </p>
            </div>
          </div>

          <div class="panel panel--note">
            <h2 class="panel__t">Cara kerja</h2>
            <p>
              Setiap perubahan disimpan ke repositori GitHub, lalu Vercel membangun ulang
              situs secara otomatis. Situs biasanya tayang kembali dalam 15–30 detik.
              Selama proses itu, versi lama tetap bisa diakses pembaca — tidak ada halaman
              yang mati.
            </p>
          </div>
        </section>

        <!-- ═══ ARTIKEL ═══ -->
        <section class="view" data-view="articles" hidden>
          <header class="vh">
            <div>
              <span class="eyebrow">Konten</span>
              <h1 class="vh__title">Artikel</h1>
            </div>
            <div class="vh__actions">
              <input class="inp inp--search" id="art-search" placeholder="Cari judul…" />
              <button class="btn btn--gold" id="new-article-btn2">+ Artikel baru</button>
            </div>
          </header>
          <div class="tblwrap panel">
            <table class="tbl">
              <thead>
                <tr><th>Judul</th><th>Rubrik</th><th>Tanggal</th><th>Status</th><th></th></tr>
              </thead>
              <tbody id="article-rows"></tbody>
            </table>
          </div>
        </section>

        <!-- ═══ IKLAN ═══ -->
        <section class="view" data-view="ads" hidden>
          <header class="vh">
            <div>
              <span class="eyebrow">Monetisasi</span>
              <h1 class="vh__title">Ruang Iklan</h1>
            </div>
            <div class="vh__actions">
              <button class="btn btn--gold" id="save-ads-btn">Simpan perubahan</button>
            </div>
          </header>

          <p class="note">
            Semua yang Anda ubah di halaman ini tampil di <strong>/iklan</strong> dan
            di <strong>media kit PDF</strong>. Setelah menekan “Simpan perubahan”,
            tunggu 1–2 menit lalu muat ulang halaman iklan.
          </p>

          <div class="panel">
            <div class="panel__h">
              <h2 class="panel__t">Isi iklan (tayang di situs)</h2>
              <span class="panel__meta">Gambar + tautan pemasang</span>
            </div>
            <p class="note note--panel">
              Selama sebuah slot <strong>kosong</strong>, pengunjung melihat kotak
              “Tersedia — pasang iklan Anda di sini”. Begitu Anda mengisi gambar dan
              tautannya lalu mengaktifkannya, slot itu berganti menjadi iklan
              pemasang di seluruh halaman yang memakainya.
            </p>
            <div class="adfill" id="adfill-rows"></div>
          </div>

          <div class="panel">
            <div class="panel__h">
              <h2 class="panel__t">Slot iklan</h2>
              <span class="panel__meta">Tarif &amp; catatan per slot</span>
            </div>
            <div class="tblwrap">
              <table class="tbl">
                <thead>
                  <tr><th>Slot</th><th>Ukuran</th><th>Tarif</th><th>Catatan</th></tr>
                </thead>
                <tbody id="slot-rows"></tbody>
              </table>
            </div>
          </div>

          <div class="panel">
            <div class="panel__h">
              <h2 class="panel__t">Paket kemitraan</h2>
              <span class="panel__meta">Kartu paket di /iklan</span>
            </div>
            <div class="tblwrap">
              <table class="tbl">
                <thead>
                  <tr><th>Paket</th><th>Harga</th><th>Periode</th><th>Deskripsi</th></tr>
                </thead>
                <tbody id="pkg-rows"></tbody>
              </table>
            </div>
          </div>

          <div class="panel">
            <div class="panel__h">
              <h2 class="panel__t">Format iklan</h2>
              <span class="panel__meta">Tabel ukuran &amp; tarif di /iklan</span>
            </div>
            <div class="tblwrap">
              <table class="tbl">
                <thead>
                  <tr><th>Format</th><th>Ukuran</th><th>Tarif</th><th>Penempatan</th></tr>
                </thead>
                <tbody id="fmt-rows"></tbody>
              </table>
            </div>
          </div>

          <div class="panel">
            <div class="panel__h">
              <h2 class="panel__t">Data audiens</h2>
              <span class="panel__meta">Angka di halaman media kit</span>
            </div>
            <div class="mini-grid" id="audience-fields"></div>
          </div>
        </section>

        <!-- ═══ STATISTIK ═══ -->
        <section class="view" data-view="stats" hidden>
          <header class="vh">
            <div>
              <span class="eyebrow">Analitik</span>
              <h1 class="vh__title">Statistik</h1>
            </div>
          </header>
          <div class="cards" id="stat-cards"></div>
          <div class="panel">
            <div class="panel__h">
              <h2 class="panel__t">Pembaca harian</h2>
              <span class="panel__meta">30 hari terakhir</span>
            </div>
            <div class="chart" id="chart"></div>
          </div>
          <div class="grid2">
            <div class="panel">
              <div class="panel__h"><h2 class="panel__t">Sumber kunjungan</h2></div>
              <ul class="bars" id="source-bars"></ul>
            </div>
            <div class="panel">
              <div class="panel__h"><h2 class="panel__t">Perangkat</h2></div>
              <ul class="bars" id="device-bars"></ul>
            </div>
          </div>
          <div class="panel">
            <div class="panel__h">
              <h2 class="panel__t">Artikel paling dibaca</h2>
            </div>
            <div class="tblwrap">
              <table class="tbl">
                <thead><tr><th>#</th><th>Judul</th><th>Pembaca</th><th>Rata-rata baca</th></tr></thead>
                <tbody id="top-rows"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ═══ PENGATURAN ═══ -->
        <section class="view" data-view="settings" hidden>
          <header class="vh">
            <div>
              <span class="eyebrow">Situs</span>
              <h1 class="vh__title">Pengaturan</h1>
            </div>
            <div class="vh__actions">
              <button class="btn btn--gold" id="save-settings-btn">Simpan perubahan</button>
            </div>
          </header>
          <div class="panel">
            <div class="panel__h"><h2 class="panel__t">Identitas</h2></div>
            <div class="mini-grid" id="site-fields"></div>
          </div>
          <div class="panel">
            <div class="panel__h">
              <h2 class="panel__t">Rubrik</h2>
              <span class="panel__meta">Tagline & deskripsi</span>
            </div>
            <div id="rubrik-fields"></div>
          </div>
        </section>
      </main>
    </div>

    <!-- ═══════════ EDITOR ARTIKEL ═══════════ -->
    <div class="drawer" id="drawer" hidden>
      <div class="drawer__scrim" data-close></div>
      <div class="drawer__panel">
        <header class="drawer__h">
          <h2 class="drawer__t" id="drawer-title">Artikel baru</h2>
          <button class="drawer__x" data-close aria-label="Tutup">✕</button>
        </header>

        <form class="drawer__body" id="article-form">
          <input type="hidden" id="f-original-slug" />

          <label class="fld">
            <span class="fld__label">Judul</span>
            <input class="inp" id="f-title" required />
          </label>

          <div class="row3">
            <label class="fld">
              <span class="fld__label">
                Rubrik
                <span class="fld__hint">menentukan alamat halaman rubrik</span>
              </span>
              <select class="inp" id="f-rubrik"></select>
            </label>
            <label class="fld">
              <span class="fld__label">Tanggal terbit</span>
              <input class="inp" type="date" id="f-date" />
            </label>
            <label class="fld">
              <span class="fld__label">Menit baca</span>
              <input class="inp" type="number" min="1" id="f-reading" />
            </label>
          </div>

          <label class="fld">
            <span class="fld__label">Slug URL <span class="fld__hint">otomatis dari judul</span></span>
            <input class="inp" id="f-slug" placeholder="pasar-yang-menolak-digusur" />
          </label>

          <label class="fld">
            <span class="fld__label">Anak judul <span class="fld__hint">opsional, tampil di bawah judul</span></span>
            <input class="inp" id="f-sujudul" />
          </label>

          <label class="fld">
            <span class="fld__label">Ringkasan (dek)</span>
            <textarea class="inp inp--area" rows="2" id="f-dek"></textarea>
          </label>

          <div class="row3">
            <label class="fld">
              <span class="fld__label">Penulis</span>
              <input class="inp" id="f-author" />
            </label>
            <label class="fld">
              <span class="fld__label">Peran penulis</span>
              <input class="inp" id="f-authorRole" />
            </label>
            <label class="fld">
              <span class="fld__label">Tag <span class="fld__hint">pisahkan koma</span></span>
              <input class="inp" id="f-tags" />
            </label>
          </div>

          <div class="fld">
            <span class="fld__label">Gambar utama</span>
            <div class="imgrow">
              <select class="inp" id="f-image"></select>
              <button type="button" class="btn btn--ghost" id="upload-btn">Unggah…</button>
            </div>
            <input type="file" id="upload-input" accept="image/*" hidden />
            <p class="fld__hint" id="upload-note">
              Unggah foto dari komputer atau ponsel — otomatis dikompres ke maksimal 1600 px.
            </p>
            <img id="img-preview" class="imgprev" alt="" />
          </div>

          <label class="fld">
            <span class="fld__label">Teks alternatif gambar</span>
            <input class="inp" id="f-imageAlt" />
          </label>

          <div class="fld">
            <span class="fld__label">
              Isi tulisan
              <span class="fld__hint">Tulis biasa saja — tidak perlu tanda apa pun.</span>
            </span>

            <div class="beditor">
              <div class="beditor__list" id="bed-blocks"></div>
              <div class="beditor__add">
                <button type="button" class="btn btn--ghost" data-bed-add="p">+ Paragraf</button>
                <button type="button" class="btn btn--ghost" data-bed-add="h2">+ Subjudul</button>
                <button type="button" class="btn btn--ghost" data-bed-add="quote">+ Kutipan</button>
              </div>
              <p class="fld__hint">
                Tekan Enter dua kali di dalam paragraf untuk memecahnya menjadi dua paragraf.
              </p>
            </div>
          </div>

          <label class="fld fld--check">
            <input type="checkbox" id="f-feature" />
            <span>Tampilkan sebagai unggulan di beranda</span>
          </label>

          <p class="drawer__err" id="drawer-err" hidden></p>

          <div class="drawer__foot">
            <button type="button" class="btn btn--ghost" data-close>Batal</button>
            <button type="submit" class="btn btn--gold" id="save-article-btn">
              Simpan & terbitkan
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ═══════════ PEMBERITAHUAN ═══════════ -->
    <input type="file" id="ad-upload-input" accept="image/*" hidden />
    <div class="toast" id="toast" hidden></div>

    <style>
      /* ══ Dasar ══ */
      .adm {
        /* Halaman admin tidak memakai masthead situs, jadi warisan
           padding-top body (ruang untuk header fixed) harus dinolkan.
           Tanpa ini muncul pita kosong setinggi ±208px di atas layar. */
        padding-top: 0 !important;
        min-height: 100vh;

        --ink: #14120f;
        --ink-soft: #3d3830;
        --muted: #6b6152;
        --line: #ddd3bf;
        --paper: #f6f2e9;
        --card: #fffdf8;
        --gold: #b08736;
        --gold-soft: #f0e3c2;
        --ok: #2f6b45;
        --warn: #9a5b18;
        --err: #9b2c2c;
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Jost', system-ui, sans-serif;
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      .adm *,
      .adm *::before,
      .adm *::after { box-sizing: border-box; }
      .adm button { font: inherit; cursor: pointer; }

      /* ══ Aturan keselamatan ══
         Atribut `hidden` di HTML kalah dari `display` di CSS. Tanpa baris
         ini, `.gate` dan `.app` yang punya `display: grid` akan tetap
         tampil meski sudah diberi `hidden` — akibatnya panel login
         menutupi dashboard selamanya dan tombol Masuk terasa mati. */
      .gate[hidden],
      .app[hidden] { display: none; }

      /* ══ Gerbang masuk ══ */
      .gate {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
        background:
          radial-gradient(circle at 30% 20%, #1f1c18, #0e0c0a 70%);
      }
      .gate__card {
        width: min(430px, 100%);
        background: var(--card);
        border-radius: 4px;
        padding: clamp(1.75rem, 4vw, 2.75rem);
        box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.7);
        border-top: 3px solid var(--gold);
      }
      .gate__brand { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1.75rem; }
      .gate__name {
        display: block;
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: 1.05rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      .gate__sub {
        display: block;
        font-size: 0.62rem;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: var(--gold);
      }
      .gate__title {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: 1.7rem;
        font-weight: 500;
        margin: 0 0 0.4rem;
      }
      .gate__desc { color: var(--muted); font-size: 0.9rem; margin: 0 0 1.5rem; }
      .gate__form { display: grid; gap: 1rem; }
      .gate__err {
        color: var(--err);
        font-size: 0.85rem;
        margin: 0;
        padding: 0.6rem 0.8rem;
        background: #fdf0ef;
        border-left: 2px solid var(--err);
      }
      .gate__foot {
        margin: 1.5rem 0 0;
        font-size: 0.75rem;
        color: #8b8272;
        border-top: 1px solid var(--line);
        padding-top: 1rem;
      }
      .gate__foot code {
        background: var(--gold-soft);
        padding: 0.1em 0.35em;
        font-size: 0.95em;
      }

      /* ══ Kerangka ══ */
      .app { display: grid; grid-template-columns: 248px 1fr; min-height: 100vh; }
      .side {
        position: sticky;
        top: 0;
        height: 100vh;
        background: #12100e;
        color: #efe9dc;
        display: flex;
        flex-direction: column;
        padding: 1.4rem 0;
      }
      .side__brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0 1.4rem 1.4rem;
        border-bottom: 1px solid rgba(240, 227, 194, 0.12);
      }
      .side__name {
        display: block;
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: 0.95rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .side__sub {
        display: block;
        font-size: 0.58rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--gold-200, #e1c577);
        opacity: 0.8;
      }
      .side__nav { display: flex; flex-direction: column; gap: 2px; padding: 1rem 0.7rem; flex: 1; }
      /* Petunjuk singkat di atas daftar panel — menjawab "ubah di mana?". */
      .note--panel { margin: 0.9rem 1rem 0; }
      .note {
        margin: 0 0 1.25rem;
        padding: 0.85rem 1rem;
        background: #fdf8ec;
        border: 1px solid #e8dcc0;
        border-left: 3px solid var(--gold);
        border-radius: 6px;
        font-size: 0.86rem;
        line-height: 1.6;
        color: var(--ink-soft);
      }
      .note strong { color: var(--ink); font-weight: 600; }

      .snav {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        width: 100%;
        background: none;
        border: 0;
        color: rgba(239, 233, 220, 0.72);
        padding: 0.62rem 0.75rem;
        border-radius: 3px;
        font-size: 0.86rem;
        letter-spacing: 0.02em;
        text-align: left;
        transition: background 0.2s, color 0.2s;
      }
      .snav svg {
        width: 17px; height: 17px;
        fill: none; stroke: currentColor; stroke-width: 1.5;
        stroke-linecap: round; stroke-linejoin: round;
        flex: none;
      }
      .snav:hover { background: rgba(240, 227, 194, 0.08); color: #fff; }
      .snav.is-on { background: var(--gold); color: #14120f; font-weight: 500; }
      .snav__count {
        margin-left: auto;
        font-size: 0.68rem;
        background: rgba(0,0,0,0.12);
        padding: 0.05em 0.45em;
        border-radius: 2px;
      }
      .snav.is-on .snav__count { background: rgba(0,0,0,0.16); }
      .side__foot {
        padding: 1rem 1.4rem 0;
        border-top: 1px solid rgba(240, 227, 194, 0.12);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .side__link {
        background: none; border: 0; padding: 0;
        color: rgba(239, 233, 220, 0.6);
        font-size: 0.78rem; text-align: left; text-decoration: none;
      }
      .side__link:hover { color: #e1c577; }

      .main { padding: clamp(1.5rem, 3vw, 2.75rem); max-width: 1280px; }

      /* ══ Kepala tampilan ══ */
      .vh {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-bottom: 1.75rem;
      }
      .eyebrow {
        font-size: 0.62rem;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: var(--gold);
      }
      .vh__title {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        font-weight: 500;
        margin: 0.2rem 0 0;
        line-height: 1.1;
      }
      .vh__actions { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }

      .btn {
        border: 1px solid transparent;
        padding: 0.6rem 1.1rem;
        font-size: 0.82rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        transition: all 0.2s;
        background: #fff;
        color: var(--ink);
        border-radius: 2px;
      }
      .btn--gold { background: var(--ink); color: #f6f2e9; }
      .btn--gold:hover { background: #000; }
      .btn--ghost { border-color: var(--line); background: transparent; }
      .btn--ghost:hover { border-color: var(--gold); color: var(--gold); }
      .btn:disabled { opacity: 0.5; cursor: not-allowed; }

      /* ══ Kartu KPI ══ */
      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      .kpi {
        background: var(--card);
        border: 1px solid var(--line);
        padding: 1.1rem 1.15rem;
        border-radius: 3px;
        position: relative;
        overflow: hidden;
      }
      .kpi::before {
        content: '';
        position: absolute;
        inset: 0 auto 0 0;
        width: 2px;
        background: var(--gold);
      }
      .kpi__label {
        font-size: 0.66rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .kpi__val {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: 1.85rem;
        line-height: 1.15;
        margin: 0.25rem 0 0.15rem;
      }
      .kpi__delta { font-size: 0.75rem; }
      .kpi__delta.up { color: var(--ok); }
      .kpi__delta.down { color: var(--err); }

      /* ══ Panel ══ */
      .panel {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 3px;
        padding: 1.25rem 1.35rem 1.4rem;
        margin-bottom: 1.25rem;
      }
      .panel--note { background: #fbf7ee; border-style: dashed; }
      .panel--note p { margin: 0; color: var(--ink-soft); font-size: 0.88rem; max-width: 78ch; }
      .panel__h {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.1rem;
        flex-wrap: wrap;
      }
      .panel__t {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: 1.06rem;
        font-weight: 500;
        margin: 0;
      }
      .panel__meta {
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .panel__link {
        background: none; border: 0; padding: 0;
        color: var(--gold); font-size: 0.78rem;
      }
      .panel__link:hover { text-decoration: underline; }

      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
      .mini-grid {
        display: grid;
        /* 240px agar placeholder panjang tidak terpotong di tengah kata. */
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1rem;
      }
      /* Field deskripsi butuh lebar penuh — isinya kalimat panjang. */
      .mini-grid .fld--wide { grid-column: 1 / -1; }

      /* ══ Grafik ══ */
      .spark { display: flex; align-items: flex-end; gap: 4px; height: 120px; }
      .spark__bar {
        flex: 1;
        background: linear-gradient(to top, #e8dcc0, var(--gold));
        border-radius: 1px 1px 0 0;
        min-height: 3px;
        position: relative;
        transition: filter 0.15s;
      }
      .spark__bar:hover { filter: brightness(1.12); }
      .spark__legend {
        display: flex;
        justify-content: space-between;
        font-size: 0.68rem;
        color: var(--muted);
        margin-top: 0.5rem;
      }
      .chart { display: flex; align-items: flex-end; gap: 3px; height: 180px; }
      .chart__bar {
        flex: 1;
        background: var(--gold);
        opacity: 0.82;
        border-radius: 1px 1px 0 0;
        min-height: 2px;
        transition: opacity 0.15s;
      }
      .chart__bar:hover { opacity: 1; }

      /* ══ Batang persen ══ */
      .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }
      .bars li { display: grid; gap: 0.3rem; }
      .bars__top { display: flex; justify-content: space-between; font-size: 0.84rem; }
      .bars__val { color: var(--muted); font-variant-numeric: tabular-nums; }
      .bars__track { height: 5px; background: #ece5d6; border-radius: 3px; overflow: hidden; }
      .bars__fill { height: 100%; background: var(--gold); border-radius: 3px; }

      /* ══ Tabel ══ */
      .tblwrap { overflow-x: auto; }
      .tbl { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
      .tbl th {
        text-align: left;
        font-weight: 500;
        font-size: 0.64rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        padding: 0 0.7rem 0.6rem;
        border-bottom: 1px solid var(--line);
        white-space: nowrap;
      }
      .tbl td {
        padding: 0.7rem;
        border-bottom: 1px solid #f0ebdf;
        vertical-align: middle;
      }
      .tbl tr:last-child td { border-bottom: 0; }
      .tbl tbody tr:hover { background: #fdfaf3; }
      .tbl__title { font-weight: 500; }
      .tbl__sub { display: block; color: var(--muted); font-size: 0.76rem; }
      .tbl__act { display: flex; gap: 0.4rem; justify-content: flex-end; }
      .iact {
        background: none;
        border: 1px solid var(--line);
        border-radius: 2px;
        padding: 0.26rem 0.55rem;
        font-size: 0.72rem;
        color: var(--ink-soft);
      }
      .iact:hover { border-color: var(--gold); color: var(--gold); }
      .iact--del:hover { border-color: var(--err); color: var(--err); }

      .pill {
        display: inline-block;
        font-size: 0.64rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.15em 0.5em;
        border-radius: 2px;
        background: var(--gold-soft);
        color: #7a5c1f;
      }
      .pill--live { background: #e4f0e8; color: var(--ok); }

      /* ══ Formulir ══ */
      .fld { display: grid; gap: 0.35rem; }
      .fld__label {
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .fld__hint {
        text-transform: none;
        letter-spacing: 0;
        font-size: 0.72rem;
        color: #9c9384;
      }
      .fld--check {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.86rem;
      }
      .inp {
        font: inherit;
        font-size: 0.9rem;
        padding: 0.55rem 0.7rem;
        border: 1px solid var(--line);
        border-radius: 2px;
        background: #fff;
        color: var(--ink);
        width: 100%;
      }
      .inp:focus {
        outline: 2px solid var(--gold);
        outline-offset: -1px;
        border-color: var(--gold);
      }
      .inp--area { resize: vertical; line-height: 1.55; font-family: inherit; }
      .inp--mono { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.84rem; }
      .inp--search { width: 200px; }
      .inp--cell { padding: 0.32rem 0.45rem; font-size: 0.82rem; min-width: 90px; }
      .row3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.9rem; }
      .imgrow { display: flex; gap: 0.5rem; }
      .imgrow .inp { flex: 1; }
      .btn--sm { padding: 0.5rem 0.8rem; font-size: 0.78rem; white-space: nowrap; }

      /* ── Editor blok isi tulisan ── */
      .beditor { display: grid; gap: 0.7rem; }
      .beditor__list { display: grid; gap: 0.6rem; }
      .beditor__add { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .bed {
        border: 1px solid var(--line);
        border-radius: 3px;
        background: #fff;
        overflow: hidden;
      }
      .bed[data-type='h2'] { border-left: 3px solid var(--gold); background: #fdfbf6; }
      .bed[data-type='quote'] { border-left: 3px solid var(--ink-soft); }
      .bed__bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.25rem 0.4rem 0.25rem 0.6rem;
        background: #faf7f0;
        border-bottom: 1px solid var(--line);
      }
      .bed[data-type='h2'] .bed__bar { background: #f8f1e0; }
      .bed__tag {
        font-size: 0.68rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-soft);
        font-weight: 600;
      }
      .bed__acts { display: flex; gap: 0.15rem; }
      .bed__act {
        width: 24px;
        height: 22px;
        display: grid;
        place-items: center;
        border: 1px solid transparent;
        background: transparent;
        border-radius: 2px;
        color: var(--ink-soft);
        font-size: 0.72rem;
        cursor: pointer;
        line-height: 1;
      }
      .bed__act:hover:not(:disabled) { background: #fff; border-color: var(--line); color: var(--ink); }
      .bed__act:disabled { opacity: 0.28; cursor: default; }
      .bed__act--del:hover:not(:disabled) { color: #a1261d; border-color: #e6c3bf; background: #fdf2f0; }
      .bed__inp {
        border: 0;
        border-radius: 0;
        padding: 0.6rem 0.7rem;
        width: 100%;
        resize: vertical;
        min-height: 2.2rem;
      }
      .bed[data-type='h2'] .bed__inp { font-weight: 600; font-size: 1rem; }
      .bed[data-type='quote'] .bed__inp { font-style: italic; }
      .bed__inp:focus { outline: none; box-shadow: inset 0 0 0 2px rgba(160, 120, 40, 0.15); }
      .bed__empty {
        margin: 0;
        padding: 1.2rem;
        text-align: center;
        color: var(--ink-soft);
        font-size: 0.83rem;
        border: 1px dashed var(--line);
        border-radius: 3px;
        background: #fbf9f4;
      }

      /* ── Kartu "Isi iklan": satu slot, satu kartu ── */
      .adfill { display: grid; gap: 1rem; padding: 0.75rem 1rem 1rem; }
      .adcard { border: 1px solid var(--line); border-radius: 4px; overflow: hidden; background: #fff; }
      .adcard__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.7rem 1rem;
        background: #faf7f0;
        border-bottom: 1px solid var(--line);
        flex-wrap: wrap;
      }
      .adcard__name { display: block; font-weight: 600; font-size: 0.9rem; }
      .adcard__size { display: block; color: var(--ink-soft); font-size: 0.76rem; letter-spacing: 0.04em; }
      .adcard__switch {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.8rem;
        cursor: pointer;
        user-select: none;
      }
      .adcard__switch input { width: 16px; height: 16px; accent-color: var(--gold); cursor: pointer; }
      .adcard__grid {
        display: grid;
        grid-template-columns: 190px 1fr;
        gap: 1rem;
        padding: 1rem;
      }
      .adcard__preview {
        display: grid;
        place-items: center;
        border: 1px dashed var(--line);
        border-radius: 3px;
        background: #fbf9f4;
        min-height: 96px;
        padding: 0.5rem;
        color: var(--ink-soft);
        font-size: 0.75rem;
        text-align: center;
      }
      .adcard__preview img { max-width: 100%; max-height: 130px; object-fit: contain; display: block; }
      .adcard__fields { display: grid; gap: 0.8rem; align-content: start; }
      @media (max-width: 720px) {
        .adcard__grid { grid-template-columns: 1fr; }
      }
      .imgprev {
        display: none;
        margin-top: 0.6rem;
        width: 100%;
        max-height: 190px;
        object-fit: cover;
        border: 1px solid var(--line);
        border-radius: 2px;
      }
      .imgprev.is-on { display: block; }

      /* ══ Laci editor ══ */
      .drawer { position: fixed; inset: 0; z-index: 900; }
      .drawer[hidden] { display: none; }
      .drawer__scrim { position: absolute; inset: 0; background: rgba(18, 16, 14, 0.55); }
      .drawer__panel {
        position: absolute;
        inset: 0 0 0 auto;
        width: min(760px, 100%);
        background: var(--card);
        display: flex;
        flex-direction: column;
        box-shadow: -30px 0 80px -40px rgba(0, 0, 0, 0.5);
      }
      .drawer__h {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid var(--line);
        flex: none;
      }
      .drawer__t {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: 1.15rem;
        font-weight: 500;
        margin: 0;
      }
      .drawer__x {
        background: none; border: 0; font-size: 1.1rem; color: var(--muted);
        padding: 0.3rem 0.5rem;
      }
      .drawer__body {
        padding: 1.5rem;
        overflow-y: auto;
        display: grid;
        gap: 1.1rem;
        flex: 1;
      }
      .drawer__foot {
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
        position: sticky;
        bottom: -1.5rem;
        background: var(--card);
        padding-bottom: 0.5rem;
      }
      .drawer__err {
        margin: 0;
        padding: 0.6rem 0.8rem;
        background: #fdf0ef;
        border-left: 2px solid var(--err);
        color: var(--err);
        font-size: 0.85rem;
      }

      /* ══ Diagnostik ══ */
      .diag { display: grid; gap: 0.55rem; }
      .diag__row {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: 0.86rem;
        padding: 0.5rem 0.65rem;
        background: #fbf7ee;
        border-left: 2px solid var(--line);
        border-radius: 2px;
      }
      .diag__row.ok { border-left-color: #2f6b45; background: #f2f8f4; }
      .diag__row.bad { border-left-color: var(--err); background: #fdf3f2; }
      .diag__ico { flex: none; font-size: 0.9rem; line-height: 1.4; }
      .diag__t { font-weight: 500; }
      .diag__d { display: block; color: var(--muted); font-size: 0.78rem; margin-top: 0.1rem; }

      /* ══ Toast ══ */
      .toast {
        position: fixed;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        background: var(--ink);
        color: #f6f2e9;
        padding: 0.75rem 1.25rem;
        border-radius: 3px;
        font-size: 0.86rem;
        z-index: 1000;
        box-shadow: 0 20px 50px -20px rgba(0,0,0,0.6);
        border-left: 3px solid var(--gold);
        max-width: min(560px, 92vw);
      }
      .toast[hidden] { display: none; }
      .toast.err { border-left-color: var(--err); }

      /* ══ Responsif ══ */
      @media (max-width: 900px) {
        .app { grid-template-columns: 1fr; }
        .side {
          position: static;
          height: auto;
          flex-direction: row;
          align-items: center;
          padding: 0.7rem 0.9rem;
          gap: 0.5rem;
        }
        .side__brand { border: 0; padding: 0 0.5rem 0 0; }
        .side__name { display: none; }
        .side__nav { flex-direction: row; overflow-x: auto; padding: 0; flex: 1; }
        .snav { white-space: nowrap; padding: 0.45rem 0.6rem; }
        .snav svg { display: none; }
        .side__foot { border: 0; padding: 0; flex-direction: row; }
        .grid2 { grid-template-columns: 1fr; }
        .row3 { grid-template-columns: 1fr; }
      }
    </style>

    <script>
      /* ═══════════════════════════════════════════════════════════
         Dashboard — logika klien
         ═══════════════════════════════════════════════════════════ */
      const $ = (sel) => document.querySelector(sel);
      const $$ = (sel) => Array.from(document.querySelectorAll(sel));

      const API = '/api/admin';
      let state = {
        articles: [],
        ads: { adSlots: {}, adPackages: [], audience: [], adFormats: [] },
        settings: { site: {}, rubrik: [] },
        stats: null,
      };

      const IMAGES = [
        ['/img/hero-kronik.jpg', 'Bust marmer klasik — Kronik'],
        ['/img/khazanah-temple.jpg', 'Candi dalam kabut — Khazanah'],
        ['/img/esai-library.jpg', 'Perpustakaan tua — Esai'],
        ['/img/seni-brush.jpg', 'Sapuan emas — Seni'],
        ['/img/diskursus-forum.jpg', 'Kolom neoklasik — Diskursus'],
        ['/img/humaniora-hands.jpg', 'Tangan & foto lama — Humaniora'],
        ['/img/art-gallery.jpg', 'Galeri seni'],
        ['/img/cover-current.jpg', 'Sampul edisi'],
        ['/img/jejak-archive.jpg', 'Arsip jejak'],
        ['/img/poet-portrait.jpg', 'Potret penyair'],
      ];

      /* ── Utilitas ── */
      function toast(msg, isErr = false) {
        const el = $('#toast');
        el.textContent = msg;
        el.classList.toggle('err', isErr);
        el.hidden = false;
        clearTimeout(el._t);
        el._t = setTimeout(() => (el.hidden = true), 4200);
      }

      const num = (n) => new Intl.NumberFormat('id-ID').format(n ?? 0);

      async function api(action, body, method = 'GET') {
        const res = await fetch(`${API}?action=${action}`, {
          method: body ? 'POST' : method,
          credentials: 'same-origin',
          headers: body ? { 'Content-Type': 'application/json' } : {},
          body: body ? JSON.stringify(body) : undefined,
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw Object.assign(new Error(data.error || 'Gagal'), { data });
        return data;
      }

      /* ══ Navigasi tampilan ══ */
      function showView(name) {
        $$('.view').forEach((v) => (v.hidden = v.dataset.view !== name));
        $$('.snav').forEach((b) => b.classList.toggle('is-on', b.dataset.view === name));
        $('#main').scrollTop = 0;
        window.scrollTo(0, 0);
      }
      $('#side-nav').addEventListener('click', (e) => {
        const b = e.target.closest('.snav');
        if (b) showView(b.dataset.view);
      });
      document.addEventListener('click', (e) => {
        const g = e.target.closest('[data-goto]');
        if (g) showView(g.dataset.goto);
      });

      /* ══ Masuk / keluar ══ */
      async function boot() {
        try {
          const { authed } = await api('session');
          if (authed) await start();
          else $('#gate').hidden = false;
        } catch {
          $('#gate').hidden = false;
        }
      }

      $('#login-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = $('#login-btn');
        const err = $('#login-err');
        const pass = $('#login-pass');

        // Umpan balik seketika: tombol tidak boleh terasa "diam".
        btn.disabled = true;
        btn.textContent = 'Memeriksa…';
        err.hidden = true;

        try {
          await api('login', { password: pass.value });
          btn.textContent = 'Berhasil — membuka…';
          pass.value = '';
          await start();
        } catch (ex) {
          const msg = String(ex.message || '');
          // Jaringan putus / fungsi tidak terjangkau: jelaskan, jangan diam.
          err.textContent = /fetch|network|Failed/i.test(msg)
            ? 'Tidak bisa menghubungi server. Periksa koneksi internet Anda, lalu coba lagi.'
            : msg || 'Gagal masuk. Coba lagi.';
          err.hidden = false;
          btn.disabled = false;
          btn.textContent = 'Masuk';
          pass.select();
        }
      });

      $('#logout-btn').addEventListener('click', async () => {
        await api('logout', {}).catch(() => {});
        location.reload();
      });

      async function start() {
        $('#gate').hidden = true;
        $('#app').hidden = false;
        await loadContent();
      }

      async function loadContent() {
        try {
          const data = await api('content');
          state = { ...state, ...data };
          renderAll();
        } catch (e) {
          if (e.message.includes('Sesi')) {
            $('#app').hidden = true;
            $('#gate').hidden = false;
          } else {
            toast(e.message, true);
            // Tetap tampilkan diagnostik supaya penyebabnya terlihat.
            runDiagnostics();
          }
        }
      }

      async function runDiagnostics() {
        const body = $('#diag-body');
        body.innerHTML = `<div class="diag"><div class="diag__row">
          <span class="diag__ico">◌</span>
          <span class="diag__t">Memeriksa sambungan GitHub…</span></div></div>`;
        try {
          const r = await api('diagnose');
          const rows = [];

          rows.push({
            ok: r.repo?.ok,
            t: 'Akses repositori',
            d: r.repo?.ok
              ? `${r.repo.full_name} · ${r.repo.private ? 'privat' : 'publik'}`
              : r.repo?.error || 'Gagal memeriksa.',
          });

          rows.push({
            ok: r.read?.ok,
            t: 'Baca berkas konten',
            d: r.read?.ok
              ? `articles.json terbaca${r.read.sha ? ` (versi ${r.read.sha})` : ''}.`
              : r.read?.error || 'Gagal membaca.',
          });

          rows.push({
            ok: r.write?.ok,
            t: 'Izin menulis',
            d: r.write?.ok
              ? 'Token boleh menyimpan perubahan. Dashboard siap dipakai.'
              : r.write?.error || 'Tidak ada izin menulis.',
          });

          if (r.lastCommit) {
            rows.push({ ok: true, t: 'Commit terakhir', d: r.lastCommit });
          }

          body.innerHTML = `<div class="diag">${rows
            .map(
              (x) => `<div class="diag__row ${x.ok ? 'ok' : 'bad'}">
                <span class="diag__ico">${x.ok ? '✓' : '✕'}</span>
                <span><span class="diag__t">${esc(x.t)}</span>
                <span class="diag__d">${esc(x.d)}</span></span>
              </div>`
            )
            .join('')}</div>`;
        } catch (e) {
          body.innerHTML = `<div class="diag"><div class="diag__row bad">
            <span class="diag__ico">✕</span>
            <span><span class="diag__t">Pemeriksaan gagal</span>
            <span class="diag__d">${esc(e.message)}</span></span></div></div>`;
        }
      }

      function renderAll() {
        $('#count-articles').textContent = state.articles.length;
        renderKpi();
        renderSpark();
        renderRubrikBars();
        renderRecent();
        renderArticleTable();
        renderAds();
        renderStats();
        renderSettings();
        renderRubrikSelect();
        renderImageSelect();
        runDiagnostics();
      }

      /* ══ Ikhtisar ══ */
      function trafficSeries(days = 14) {
        const d = state.stats?.daily;
        if (Array.isArray(d) && d.length) return d.slice(-days);
        return [];
      }

      function renderKpi() {
        const s = state.stats;
        const daily = trafficSeries(30);
        const totalMonth = daily.reduce((a, b) => a + (b.views || 0), 0);
        const last7 = trafficSeries(7).reduce((a, b) => a + (b.views || 0), 0);
        const prev7 = trafficSeries(14).slice(0, 7).reduce((a, b) => a + (b.views || 0), 0);
        const delta = prev7 ? Math.round(((last7 - prev7) / prev7) * 100) : 0;

        const cards = [
          ['Artikel terbit', num(state.articles.length), `${state.settings.rubrik?.length || 0} rubrik`],
          ['Pembaca 30 hari', num(totalMonth), `${delta >= 0 ? '▲' : '▼'} ${Math.abs(delta)}% vs sebelumnya`, delta >= 0 ? 'up' : 'down'],
          ['Rata-rata durasi', s?.avgDuration || '—', 'per sesi'],
          ['Slot iklan', num(Object.keys(state.ads.adSlots || {}).length), `${state.ads.adPackages?.length || 0} paket aktif`],
        ];

        $('#kpi-cards').innerHTML = cards
          .map(
            ([label, val, sub, cls]) => `
          <div class="kpi">
            <span class="kpi__label">${label}</span>
            <p class="kpi__val">${val}</p>
            <span class="kpi__delta ${cls || ''}">${sub}</span>
          </div>`
          )
          .join('');
      }

      function renderSpark() {
        const series = trafficSeries(14);
        const el = $('#spark');
        if (!series.length) {
          el.innerHTML = `<p style="color:#8b8272;font-size:.86rem;margin:0">
            Belum ada data kunjungan. Isi <code>src/data/content/traffic.json</code>
            atau sambungkan Google Analytics untuk melihat angkanya di sini.</p>`;
          $('#spark-legend').innerHTML = '';
          return;
        }
        const max = Math.max(...series.map((d) => d.views || 0), 1);
        el.innerHTML = series
          .map(
            (d) =>
              `<div class="spark__bar" style="height:${Math.max(
                3,
                ((d.views || 0) / max) * 100
              )}%" title="${d.date}: ${num(d.views)} pembaca"></div>`
          )
          .join('');
        $('#spark-legend').innerHTML = `<span>${series[0].date}</span><span>${series[series.length - 1].date}</span>`;
      }

      function renderRubrikBars() {
        const byR = {};
        for (const a of state.articles) byR[a.rubrik] = (byR[a.rubrik] || 0) + 1;
        const max = Math.max(...Object.values(byR), 1);
        $('#rubrik-bars').innerHTML = Object.entries(byR)
          .sort((a, b) => b[1] - a[1])
          .map(
            ([k, v]) => `
          <li>
            <div class="bars__top"><span>${k}</span><span class="bars__val">${v}</span></div>
            <div class="bars__track"><div class="bars__fill" style="width:${(v / max) * 100}%"></div></div>
          </li>`
          )
          .join('');
      }

      function renderRecent() {
        const rows = [...state.articles]
          .sort((a, b) => String(b.date).localeCompare(String(a.date)))
          .slice(0, 6);
        $('#recent-rows').innerHTML = rows
          .map(
            (a) => `
          <tr>
            <td><span class="tbl__title">${esc(a.title)}</span>
                <span class="tbl__sub">${esc(a.author)}</span></td>
            <td><span class="pill">${esc(a.rubrik)}</span></td>
            <td>${esc(a.date)}</td>
            <td>${a.reading} mnt</td>
            <td><div class="tbl__act">
              <button class="iact" data-edit="${esc(a.slug)}">Ubah</button>
            </div></td>
          </tr>`
          )
          .join('');
      }

      /* ══ Artikel ══ */
      /* structuredClone belum ada di Safari sebelum 15.4 dan di sebagian
         peramban dalam aplikasi. Tanpa cadangan ini, tombol Simpan pada
         halaman iklan dan pengaturan melempar galat dan tidak berbuat apa pun. */
      const salin = (obj) => {
        try {
          if (typeof structuredClone === 'function') return structuredClone(obj);
        } catch {
          /* lanjut ke cadangan */
        }
        return JSON.parse(JSON.stringify(obj));
      };

      const esc = (s = '') =>
        String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      function renderArticleTable(filter = '') {
        const q = filter.toLowerCase();
        const rows = state.articles.filter(
          (a) => !q || a.title.toLowerCase().includes(q) || a.slug.includes(q)
        );
        $('#article-rows').innerHTML = rows.length
          ? rows
              .map(
                (a) => `
          <tr>
            <td><span class="tbl__title">${esc(a.title)}</span>
                <span class="tbl__sub">/${esc(a.slug)}</span></td>
            <td><span class="pill">${esc(a.rubrik)}</span></td>
            <td>${esc(a.date)}</td>
            <td>${a.feature ? '<span class="pill pill--live">Unggulan</span>' : '<span class="pill">Biasa</span>'}</td>
            <td><div class="tbl__act">
              <a class="iact" href="/tulisan/${esc(a.slug)}" target="_blank" rel="noopener">Lihat</a>
              <button class="iact" data-edit="${esc(a.slug)}">Ubah</button>
              <button class="iact iact--del" data-del="${esc(a.slug)}">Hapus</button>
            </div></td>
          </tr>`
              )
              .join('')
          : `<tr><td colspan="5" style="color:#8b8272;padding:1.5rem 0.7rem">
               Belum ada artikel yang cocok.</td></tr>`;
      }

      $('#art-search').addEventListener('input', (e) => renderArticleTable(e.target.value));

      document.addEventListener('click', async (e) => {
        const editBtn = e.target.closest('[data-edit]');
        if (editBtn) return openEditor(state.articles.find((a) => a.slug === editBtn.dataset.edit));

        const delBtn = e.target.closest('[data-del]');
        if (delBtn) {
          const slug = delBtn.dataset.del;
          const a = state.articles.find((x) => x.slug === slug);
          if (!confirm(`Hapus "${a?.title}"?\n\nTindakan ini menulis ulang repositori dan tidak bisa dibatalkan dari dashboard.`)) return;
          try {
            await api('delete-article', { slug });
            toast('Artikel dihapus. Situs sedang dibangun ulang.');
            await loadContent();
          } catch (ex) {
            toast(ex.message, true);
          }
        }
      });

      /* ── Editor ── */
      function renderRubrikSelect() {
        $('#f-rubrik').innerHTML = (state.settings.rubrik || [])
          .map((r) => `<option value="${r.slug}">${r.name}</option>`)
          .join('');
      }
      function renderImageSelect() {
        $('#f-image').innerHTML = IMAGES.map(
          ([v, l]) => `<option value="${v}">${l}</option>`
        ).join('');
      }

      /* ═══════════════════════════════════════════════════════════
         Editor blok — pengganti ketikan "## " / "> ".
         Admin hanya melihat kotak teks biasa dengan label yang jelas;
         di balik layar blok-blok ini diubah kembali menjadi teks
         bertanda ("## ", "> ") saat disimpan, sehingga format berkas
         artikel lama tidak berubah sama sekali.
         ═══════════════════════════════════════════════════════════ */
      const bedState = { blocks: [] };

      const PARAGRAF_KOSONG = '<p class="bed__empty">Belum ada isi. Klik “+ Paragraf” untuk mulai menulis.</p>';

      function bedRender() {
        const list = $('#bed-blocks');
        if (!bedState.blocks.length) {
          list.innerHTML = PARAGRAF_KOSONG;
          return;
        }
        list.innerHTML = bedState.blocks
          .map(
            (b, i) => `
          <div class="bed" data-bed="${i}" data-type="${b.type}">
            <div class="bed__bar">
              <span class="bed__tag">${
                b.type === 'h2' ? 'Subjudul' : b.type === 'quote' ? 'Kutipan' : 'Paragraf'
              }</span>
              <div class="bed__acts">
                <button type="button" class="bed__act" data-bed-up="${i}" title="Pindah ke atas" ${
                  i === 0 ? 'disabled' : ''
                }>↑</button>
                <button type="button" class="bed__act" data-bed-down="${i}" title="Pindah ke bawah" ${
                  i === bedState.blocks.length - 1 ? 'disabled' : ''
                }>↓</button>
                <button type="button" class="bed__act bed__act--del" data-bed-del="${i}" title="Hapus">✕</button>
              </div>
            </div>
            <textarea class="inp inp--area bed__inp" rows="${
              b.type === 'p' ? 4 : b.type === 'h2' ? 1 : 2
            }" data-bed-text="${i}" placeholder="${
              b.type === 'h2' ? 'Tulis subjudul…' : b.type === 'quote' ? 'Tulis kutipan…' : 'Tulis paragraf…'
            }"></textarea>
          </div>`
          )
          .join('');

        // Isi nilai setelah dipasang agar Enter/newline tidak hilang.
        bedState.blocks.forEach((b, i) => {
          const el = list.querySelector(`[data-bed-text="${i}"]`);
          if (el) el.value = b.text;
        });
      }

      /** Teks bertanda atau larik blok → daftar blok (dipakai saat membuka artikel). */
      function bedFromText(input = '') {
        // Artikel lama sudah tersimpan sebagai larik {type,text} — pakai apa adanya.
        if (Array.isArray(input)) {
          return input
            .filter((b) => b && String(b.text || '').trim())
            .map((b) => ({ type: b.type === 'h2' || b.type === 'quote' ? b.type : 'p', text: String(b.text) }));
        }
        const blocks = [];
        String(input)
          .replace(/\r\n/g, '\n')
          .split(/\n\s*\n/)
          .forEach((chunk) => {
            const t = chunk.trim();
            if (!t) return;
            if (t.startsWith('## ')) blocks.push({ type: 'h2', text: t.slice(3).trim() });
            else if (t.startsWith('> ')) blocks.push({ type: 'quote', text: t.slice(2).trim() });
            else blocks.push({ type: 'p', text: t });
          });
        return blocks;
      }

      /** Daftar blok → teks bertanda (dipakai saat menyimpan). */
      function bedToText() {
        return bedState.blocks
          .map((b) => {
            const t = b.text.trim();
            if (!t) return '';
            if (b.type === 'h2') return `## ${t.replace(/^#+\s*/, '')}`;
            if (b.type === 'quote') return `> ${t.replace(/^>\s*/, '')}`;
            return t;
          })
          .filter(Boolean)
          .join('\n\n');
      }

      function bedSetFromText(text) {
        bedState.blocks = bedFromText(text);
        // Artikel baru tanpa isi: sediakan satu paragraf kosong agar siap ketik.
        if (!bedState.blocks.length) bedState.blocks.push({ type: 'p', text: '' });
        bedRender();
      }

      // Simpan ketikan ke state (input, tanpa render ulang → kursor tidak melompat).
      document.addEventListener('input', (e) => {
        const el = e.target.closest('[data-bed-text]');
        if (!el) return;
        const i = Number(el.dataset.bedText);
        if (bedState.blocks[i]) bedState.blocks[i].text = el.value;
      });

      document.addEventListener('click', (e) => {
        const add = e.target.closest('[data-bed-add]');
        if (add) {
          bedState.blocks.push({ type: add.dataset.bedAdd, text: '' });
          bedRender();
          const inputs = document.querySelectorAll('#bed-blocks [data-bed-text]');
          inputs[inputs.length - 1]?.focus();
          return;
        }
        const del = e.target.closest('[data-bed-del]');
        if (del) {
          bedState.blocks.splice(Number(del.dataset.bedDel), 1);
          bedRender();
          return;
        }
        const up = e.target.closest('[data-bed-up]');
        if (up) {
          const i = Number(up.dataset.bedUp);
          [bedState.blocks[i - 1], bedState.blocks[i]] = [bedState.blocks[i], bedState.blocks[i - 1]];
          bedRender();
          return;
        }
        const down = e.target.closest('[data-bed-down]');
        if (down) {
          const i = Number(down.dataset.bedDown);
          [bedState.blocks[i + 1], bedState.blocks[i]] = [bedState.blocks[i], bedState.blocks[i + 1]];
          bedRender();
        }
      });

      function openEditor(a) {
        const isNew = !a;
        $('#drawer-title').textContent = isNew ? 'Artikel baru' : 'Ubah artikel';

        const f = {
          title: a?.title || '',
          sujudul: a?.sujudul || '',
          dek: a?.dek || '',
          author: a?.author || 'Tim Redaksi',
          authorRole: a?.authorRole || 'Kontributor',
          date: a?.date || new Date().toISOString().slice(0, 10),
          reading: a?.reading || 6,
          slug: a?.slug || '',
          rubrik: a?.rubrik || 'kronik',
          tags: (a?.tags || []).join(', '),
          image: a?.image || IMAGES[0][0],
          imageAlt: a?.imageAlt || '',
          body: a?.body || [],
          feature: Boolean(a?.feature),
          originalSlug: a?.slug || '',
        };

        $('#f-title').value = f.title;
        $('#f-sujudul').value = f.sujudul;
        $('#f-dek').value = f.dek;
        $('#f-author').value = f.author;
        $('#f-authorRole').value = f.authorRole;
        $('#f-date').value = f.date;
        $('#f-reading').value = f.reading;
        $('#f-slug').value = f.slug;
        $('#f-rubrik').value = f.rubrik;
        $('#f-tags').value = f.tags;
        $('#f-image').value = f.image;
        $('#f-imageAlt').value = f.imageAlt;
        bedSetFromText(f.body);
        $('#f-feature').checked = f.feature;
        $('#f-original-slug').value = f.originalSlug;
        $('#drawer-err').hidden = true;

        // Tambahkan pilihan gambar khusus artikel — SEKALI saja.
        // Versi lama selalu menyisipkan opsi baru setiap kali editor dibuka,
        // sehingga membuka-tutup artikel berkali-kali menumpuk duplikat yang
        // sama di daftar (10 → 13 opsi setelah tiga kali buka).
        // Pakai f.image (sudah dinormalkan), bukan a.image. Artikel lama tanpa
        // bidang `image` membuat a.image = undefined, dan versi sebelumnya
        // menambahkan opsi bernilai "undefined" pada setiap kali dibuka.
        if (f.image && !IMAGES.some(([v]) => v === f.image)) {
          const select = $('#f-image');
          const nilai = f.image;
          let opsi = [...select.options].find((o) => o.value === nilai);
          if (!opsi) {
            opsi = new Option(`${nilai} (khusus artikel ini)`, nilai);
            select.add(opsi, 0);
          }
          select.value = nilai;
        }

        previewImage(f.image);
        $('#upload-note').textContent =
          'Unggah foto dari komputer atau ponsel — otomatis dikompres ke maksimal 1600 px.';
        $('#drawer').hidden = false;
        document.body.style.overflow = 'hidden';
        setTimeout(() => $('#f-title').focus(), 90);
      }

      function closeEditor() {
        $('#drawer').hidden = true;
        document.body.style.overflow = '';
      }

      $('#drawer').addEventListener('click', (e) => {
        if (e.target.closest('[data-close]')) closeEditor();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !$('#drawer').hidden) closeEditor();
      });

      // Slug otomatis mengikuti judul (selama belum diubah manual).
      let slugTouched = false;
      $('#f-slug').addEventListener('input', () => (slugTouched = true));
      $('#f-title').addEventListener('input', (e) => {
        if (slugTouched) return;
        $('#f-slug').value = e.target.value
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-');
      });
      $('#new-article-btn').addEventListener('click', () => {
        slugTouched = false;
        openEditor(null);
      });
      $('#new-article-btn2').addEventListener('click', () => {
        slugTouched = false;
        openEditor(null);
      });

      $('#article-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = $('#save-article-btn');
        const err = $('#drawer-err');
        btn.disabled = true;
        btn.textContent = 'Menyimpan…';
        err.hidden = true;

        if (!bedToText().trim()) {
          err.textContent = 'Isi tulisan masih kosong. Klik “+ Paragraf” lalu tulis isi artikel.';
          err.hidden = false;
          btn.disabled = false;
          btn.textContent = 'Simpan';
          return;
        }

        const payload = {
          originalSlug: $('#f-original-slug').value,
          title: $('#f-title').value,
          slug: $('#f-slug').value,
          rubrik: $('#f-rubrik').value,
          date: $('#f-date').value,
          reading: Number($('#f-reading').value),
          sujudul: $('#f-sujudul').value,
          dek: $('#f-dek').value,
          author: $('#f-author').value,
          authorRole: $('#f-authorRole').value,
          tags: $('#f-tags').value,
          image: $('#f-image').value,
          imageAlt: $('#f-imageAlt').value,
          body: bedState.blocks
            .filter((b) => b.text.trim())
            .map((b) => ({ type: b.type, text: b.text.trim() })),
          bodyText: bedToText(),
          feature: $('#f-feature').checked,
        };

        try {
          const res = await api('save-article', payload);
          closeEditor();
          toast(
            res.build?.triggered
              ? 'Tersimpan. Situs sedang dibangun ulang (~20 detik).'
              : 'Tersimpan di repositori. Vercel akan membangun ulang otomatis.'
          );
          await loadContent();
        } catch (ex) {
          err.textContent = ex.message;
          err.hidden = false;
        } finally {
          btn.disabled = false;
          btn.textContent = 'Simpan & terbitkan';
        }
      });

      /* ══ Unggah gambar ══ */
      function previewImage(src) {
        const el = $('#img-preview');
        if (!src) return el.classList.remove('is-on');
        el.src = src;
        el.alt = 'Pratinjau gambar utama';
        el.classList.add('is-on');
      }

      $('#f-image').addEventListener('change', (e) => previewImage(e.target.value));

      $('#upload-btn').addEventListener('click', () => $('#upload-input').click());

      $('#upload-input').addEventListener('change', async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const note = $('#upload-note');
        const btn = $('#upload-btn');

        btn.disabled = true;
        note.textContent = 'Mengompres & mengunggah…';

        try {
          // Baca berkas jadi data URL di sisi klien.
          const dataUrl = await new Promise((resolve, reject) => {
            const r = new FileReader();
            r.onload = () => resolve(r.result);
            r.onerror = reject;
            r.readAsDataURL(file);
          });

          const res = await fetch('/api/upload', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename: file.name, dataUrl }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Unggah gagal.');

          // Sisipkan sebagai opsi terpilih.
          const opt = document.createElement('option');
          opt.value = data.path;
          opt.textContent = `${data.path.split('/').pop()} · ${data.width}×${data.height}`;
          $('#f-image').appendChild(opt);
          $('#f-image').value = data.path;
          previewImage(data.path);

          const saved = data.originalBytes && data.originalBytes > data.bytes
            ? ` (dari ${Math.round(data.originalBytes / 1024)} KB → ${Math.round(data.bytes / 1024)} KB)`
            : '';
          note.textContent = `Terunggah${saved}. Gambar masuk ke repo dan tayang setelah situs dibangun ulang.`;
          toast('Gambar terunggah.');
        } catch (ex) {
          note.textContent = 'Gagal mengunggah. Coba berkas lain.';
          toast(ex.message, true);
        } finally {
          btn.disabled = false;
          e.target.value = '';
        }
      });

      /* ══ Iklan ══ */
      function renderAds() {
        const slots = state.ads.adSlots || {};
        $('#slot-rows').innerHTML = Object.entries(slots)
          .map(
            ([key, s]) => `
          <tr>
            <td><span class="tbl__title">${esc(s.label || key)}</span>
                <span class="tbl__sub">${esc(key)}</span></td>
            <td>${esc(s.size)}</td>
            <td><input class="inp inp--cell" data-slot="${key}" data-field="rate" value="${esc(s.rate || '')}" /></td>
            <td><input class="inp inp--cell" data-slot="${key}" data-field="note" value="${esc(s.note || '')}" style="min-width:240px" /></td>
          </tr>`
          )
          .join('');

        $('#pkg-rows').innerHTML = (state.ads.adPackages || [])
          .map(
            (p, i) => `
          <tr>
            <td><span class="tbl__title">${esc(p.name)}</span>
                <span class="tbl__sub">${esc(p.tier || '')}</span></td>
            <td><input class="inp inp--cell" data-pkg="${i}" data-field="price" value="${esc(p.price || '')}" style="min-width:130px" /></td>
            <td><input class="inp inp--cell" data-pkg="${i}" data-field="period" value="${esc(p.period || '')}" style="min-width:90px" /></td>
            <td><input class="inp inp--cell" data-pkg="${i}" data-field="desc" value="${esc(p.desc || '')}" style="min-width:300px" /></td>
          </tr>`
          )
          .join('');

        /* Panel "Isi iklan": satu kartu per slot, dengan ukuran yang
           disarankan supaya admin tidak perlu menebak dimensi. */
        $('#adfill-rows').innerHTML = Object.entries(state.ads.adSlots || {})
          .map(([key, s]) => {
            const aktif = Boolean(s.active && String(s.image || '').trim());
            return `
          <div class="adcard" data-slot-card="${key}">
            <div class="adcard__head">
              <div>
                <span class="adcard__name">${esc(s.label || key)}</span>
                <span class="adcard__size">${esc(s.size || '')} px</span>
              </div>
              <label class="adcard__switch">
                <input type="checkbox" data-ad-active="${key}" ${aktif ? 'checked' : ''} />
                <span>${aktif ? 'Tayang' : 'Kosong'}</span>
              </label>
            </div>

            <div class="adcard__grid">
              <div class="adcard__preview">
                ${s.image
                  ? `<img src="${esc(s.image)}" alt="" />`
                  : '<span>Belum ada gambar</span>'}
              </div>

              <div class="adcard__fields">
                <label class="fld">
                  <span class="fld__label">Gambar iklan</span>
                  <div class="imgrow">
                    <input class="inp" data-ad-image="${key}" value="${esc(s.image || '')}" placeholder="/img/iklan-nama.jpg" />
                    <button type="button" class="btn btn--ghost btn--sm" data-ad-upload="${key}">Unggah…</button>
                  </div>
                  <p class="fld__hint">Ukuran disarankan ${esc(s.size || '')} px. Logo & teks harus terbaca di layar ponsel.</p>
                </label>

                <label class="fld">
                  <span class="fld__label">Tautan tujuan <span class="fld__hint">https://…</span></span>
                  <input class="inp" data-ad-href="${key}" value="${esc(s.href || '')}" placeholder="https://contoh.com/promo" />
                </label>

                <div class="row3">
                  <label class="fld">
                    <span class="fld__label">Nama pemasang</span>
                    <input class="inp" data-ad-brand="${key}" value="${esc(s.brand || '')}" placeholder="Nama merek" />
                  </label>
                  <label class="fld" style="grid-column:span 2">
                    <span class="fld__label">Kalimat iklan <span class="fld__hint">tampil di bawah gambar</span></span>
                    <input class="inp" data-ad-headline="${key}" value="${esc(s.headline || '')}" placeholder="Promo akhir tahun" />
                  </label>
                </div>
              </div>
            </div>
          </div>`;
          })
          .join('');

        $('#fmt-rows').innerHTML = (state.ads.adFormats || [])
          .map(
            (f, i) => `
          <tr>
            <td><span class="tbl__title">${esc(f.name)}</span></td>
            <td><input class="inp inp--cell" data-fmt="${i}" data-field="size" value="${esc(f.size || '')}" style="min-width:100px" /></td>
            <td><input class="inp inp--cell" data-fmt="${i}" data-field="rate" value="${esc(f.rate || '')}" style="min-width:130px" /></td>
            <td><input class="inp inp--cell" data-fmt="${i}" data-field="placement" value="${esc(f.placement || '')}" style="min-width:220px" /></td>
          </tr>`
          )
          .join('');

        $('#audience-fields').innerHTML = (state.ads.audience || [])
          .map(
            (a, i) => `
          <label class="fld">
            <span class="fld__label">${esc(a.label)}</span>
            <input class="inp" data-aud="${i}" value="${esc(a.value || '')}" />
          </label>`
          )
          .join('');
      }

      $('#save-ads-btn').addEventListener('click', async () => {
        const ads = salin(state.ads);
        $$('[data-slot]').forEach((el) => {
          const key = el.dataset.slot;
          if (ads.adSlots[key]) ads.adSlots[key][el.dataset.field] = el.value;
        });
        $$('[data-pkg]').forEach((el) => {
          const i = Number(el.dataset.pkg);
          if (ads.adPackages[i]) ads.adPackages[i][el.dataset.field] = el.value;
        });
        $$('[data-aud]').forEach((el) => {
          const i = Number(el.dataset.aud);
          if (ads.audience[i]) ads.audience[i].value = el.value;
        });
        $$('[data-fmt]').forEach((el) => {
          const i = Number(el.dataset.fmt);
          if (ads.adFormats[i]) ads.adFormats[i][el.dataset.field] = el.value;
        });

        // Panel "Isi iklan" — satu slot per kartu.
        $$('[data-slot-card]').forEach((kartu) => {
          const key = kartu.dataset.slotCard;
          const slot = ads.adSlots[key];
          if (!slot) return;
          slot.image = kartu.querySelector(`[data-ad-image="${key}"]`)?.value.trim() || '';
          slot.href = kartu.querySelector(`[data-ad-href="${key}"]`)?.value.trim() || '';
          slot.brand = kartu.querySelector(`[data-ad-brand="${key}"]`)?.value.trim() || '';
          slot.headline = kartu.querySelector(`[data-ad-headline="${key}"]`)?.value.trim() || '';
          const aktifBox = kartu.querySelector(`[data-ad-active="${key}"]`);
          slot.active = Boolean(aktifBox?.checked);
        });

        // Tolak slot yang sudah diaktifkan tetapi belum lengkap — lebih baik
        // memberi tahu sekarang daripada menayangkan kotak "Tersedia" tanpa sebab.
        const tidakLengkap = Object.entries(ads.adSlots).filter(
          ([, s]) => s.active && (!String(s.image || '').trim() || !String(s.href || '').trim())
        );
        if (tidakLengkap.length) {
          toast(
            `Slot ${tidakLengkap.map(([k]) => k).join(', ')} aktif tetapi gambar/tautannya kosong. ` +
              `Lengkapi dulu, atau matikan sakelarnya.`,
            true
          );
          return;
        }

        const btn = $('#save-ads-btn');
        btn.disabled = true;
        try {
          await api('save-ads', ads);
          toast('Inventaris iklan tersimpan.');
          await loadContent();
        } catch (e) {
          toast(e.message, true);
        } finally {
          btn.disabled = false;
        }
      });

      /* ══ Unggah gambar iklan dari kartu slot ══ */
      let slotUnggah = '';
      document.addEventListener('click', (e) => {
        const t = e.target.closest('[data-ad-upload]');
        if (!t) return;
        slotUnggah = t.dataset.adUpload;
        $('#ad-upload-input').click();
      });

      $('#ad-upload-input').addEventListener('change', async (e) => {
        const file = e.target.files?.[0];
        const key = slotUnggah;
        e.target.value = '';
        if (!file || !key) return;

        const kartu = document.querySelector(`[data-slot-card="${key}"]`);
        const tombol = kartu?.querySelector('[data-ad-upload]');
        if (tombol) { tombol.disabled = true; tombol.textContent = 'Mengunggah…'; }

        try {
          const dataUrl = await new Promise((res, rej) => {
            const r = new FileReader();
            r.onload = () => res(r.result);
            r.onerror = rej;
            r.readAsDataURL(file);
          });
          const res = await fetch('/api/upload', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename: `iklan-${key}-${file.name}`, dataUrl }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Unggah gagal.');

          kartu.querySelector(`[data-ad-image="${key}"]`).value = data.path;
          const prev = kartu.querySelector('.adcard__preview');
          if (prev) prev.innerHTML = `<img src="${data.path}" alt="" />`;
          toast(`Gambar iklan terunggah (${Math.round(data.bytes / 1024)} KB). Klik “Simpan perubahan”.`);
        } catch (ex) {
          toast(ex.message, true);
        } finally {
          if (tombol) { tombol.disabled = false; tombol.textContent = 'Unggah…'; }
        }
      });

      /* ══ Statistik ══ */
      function renderStats() {
        const s = state.stats;
        const daily = trafficSeries(30);
        const total = daily.reduce((a, b) => a + (b.views || 0), 0);
        const avg = daily.length ? Math.round(total / daily.length) : 0;

        const cards = [
          ['Total pembaca', num(total), '30 hari'],
          ['Rata-rata harian', num(avg), 'pembaca'],
          ['Durasi sesi', s?.avgDuration || '—', 'rata-rata'],
          ['Rasio kembali', s?.returnRate || '—', 'pembaca setia'],
        ];
        $('#stat-cards').innerHTML = cards
          .map(
            ([l, v, sub]) => `
          <div class="kpi">
            <span class="kpi__label">${l}</span>
            <p class="kpi__val">${v}</p>
            <span class="kpi__delta">${sub}</span>
          </div>`
          )
          .join('');

        if (daily.length) {
          const max = Math.max(...daily.map((d) => d.views || 0), 1);
          $('#chart').innerHTML = daily
            .map(
              (d) =>
                `<div class="chart__bar" style="height:${Math.max(
                  2,
                  ((d.views || 0) / max) * 100
                )}%" title="${d.date}: ${num(d.views)}"></div>`
            )
            .join('');
        } else {
          $('#chart').innerHTML = `<p style="color:#8b8272;font-size:.86rem;margin:0">
            Belum ada data. Tambahkan riwayat kunjungan pada
            <code>src/data/content/traffic.json</code>.</p>`;
        }

        const bars = (arr, el) => {
          const items = arr || [];
          const max = Math.max(...items.map((i) => i.value || 0), 1);
          $(el).innerHTML = items.length
            ? items
                .map(
                  (i) => `
              <li>
                <div class="bars__top"><span>${esc(i.label)}</span>
                  <span class="bars__val">${num(i.value)}</span></div>
                <div class="bars__track"><div class="bars__fill"
                  style="width:${((i.value || 0) / max) * 100}%"></div></div>
              </li>`
                )
                .join('')
            : `<li style="color:#8b8272">Belum ada data.</li>`;
        };
        bars(s?.sources, '#source-bars');
        bars(s?.devices, '#device-bars');

        const top = s?.topArticles || [];
        $('#top-rows').innerHTML = top.length
          ? top
              .map(
                (t, i) => `
            <tr><td>${i + 1}</td>
              <td><span class="tbl__title">${esc(t.title)}</span></td>
              <td>${num(t.views)}</td>
              <td>${esc(t.avgTime || '—')}</td></tr>`
              )
              .join('')
          : `<tr><td colspan="4" style="color:#8b8272;padding:1.2rem .7rem">
              Belum ada data artikel terpopuler.</td></tr>`;
      }

      /* ══ Pengaturan ══ */
      const SITE_FIELDS = [
        ['name', 'Nama majalah'],
        ['tagline', 'Tagline'],
        ['description', 'Deskripsi'],
        ['phone', 'Telepon'],
        ['email', 'Surel redaksi'],
        ['address', 'Alamat'],
      ];

      function renderSettings() {
        const site = state.settings.site || {};
        $('#site-fields').innerHTML = SITE_FIELDS.map(
          ([k, label]) => `
          <label class="fld">
            <span class="fld__label">${label}</span>
            <input class="inp" data-site="${k}" value="${esc(site[k] || '')}" />
          </label>`
        ).join('');

        $('#rubrik-fields').innerHTML = (state.settings.rubrik || [])
          .map(
            (r, i) => `
          <div class="mini-grid" style="margin-bottom:1rem;padding-bottom:1rem;border-bottom:1px solid #f0ebdf">
            <div class="fld" style="grid-column:1/-1">
              <span class="fld__label">${esc(r.name)} <span class="fld__hint">slug: ${esc(r.slug)} — jangan diubah, alamat artikel bergantung padanya</span></span>
            </div>
            <label class="fld">
              <span class="fld__label">${esc(r.name)} — tagline</span>
              <input class="inp" data-rub="${i}" data-field="tagline" value="${esc(r.tagline || '')}" />
            </label>
            <label class="fld" style="grid-column:span 2">
              <span class="fld__label">${esc(r.name)} — deskripsi</span>
              <input class="inp" data-rub="${i}" data-field="description" value="${esc(r.description || '')}" />
            </label>
          </div>`
          )
          .join('');
      }

      $('#save-settings-btn').addEventListener('click', async () => {
        const settings = salin(state.settings);
        $$('[data-site]').forEach((el) => {
          settings.site[el.dataset.site] = el.value;
        });
        $$('[data-rub]').forEach((el) => {
          const i = Number(el.dataset.rub);
          if (settings.rubrik[i]) settings.rubrik[i][el.dataset.field] = el.value;
        });

        const btn = $('#save-settings-btn');
        btn.disabled = true;
        try {
          await api('save-settings', settings);
          toast('Pengaturan tersimpan.');
          await loadContent();
        } catch (e) {
          toast(e.message, true);
        } finally {
          btn.disabled = false;
        }
      });

      /* ══ Terbitkan ulang ══ */
      document.addEventListener('click', (e) => {
        if (e.target.closest('#diag-btn')) runDiagnostics();
      });

      $('#publish-btn').addEventListener('click', async () => {
        const btn = $('#publish-btn');
        btn.disabled = true;
        try {
          const r = await api('publish', {});
          toast(
            r.build?.triggered
              ? 'Pembangunan ulang dimulai. Situs tayang kembali ~20 detik lagi.'
              : `Tidak bisa memicu build: ${r.build?.reason || 'token Vercel belum diisi'}. Vercel tetap membangun otomatis setelah ada perubahan.`
          );
        } catch (e) {
          toast(e.message, true);
        } finally {
          btn.disabled = false;
        }
      });

      boot();
    </script>
  </body>
</html>
