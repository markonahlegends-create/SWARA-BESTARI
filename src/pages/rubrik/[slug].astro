---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { rubrik, rubrikBySlug } from '../../data/site.js';
import { byRubrik, formatDate, latest } from '../../data/articles.js';

export function getStaticPaths() {
  return rubrik.map((r) => ({ params: { slug: r.slug }, props: { rubrik: r } }));
}

const { rubrik: r } = Astro.props;
const posts = byRubrik(r.slug);
const [lead, ...rest] = posts;
const others = latest.filter((a) => a.rubrik !== r.slug).slice(0, 5);
const sibling = rubrik.filter((x) => x.slug !== r.slug);
// Dimensi intrinsik gambar: mencegah layout shift saat gambar dimuat.
const IMG_SIZES: Record<string, [number, number]> = {'art-gallery.jpg':[1400,939],'cover-current.jpg':[900,1117],'diskursus-forum.jpg':[1400,939],'esai-library.jpg':[1000,1241],'hero-kronik.jpg':[1800,1005],'humaniora-hands.jpg':[1400,939],'jejak-archive.jpg':[1400,939],'khazanah-temple.jpg':[1600,1073],'poet-portrait.jpg':[900,1117],'seni-brush.jpg':[1400,939]};
const imgW = (src: string) => IMG_SIZES[String(src).split('/').pop() || '']?.[0];
const imgH = (src: string) => IMG_SIZES[String(src).split('/').pop() || '']?.[1];
---

<Base title={`${r.name}`} description={r.description} image={`/og/rubrik-${r.slug}.jpg`}>
  <!-- ═════════ HEADER RUBRIK ═════════ -->
  <header class="rh">
    <div class="wrap">
      <div class="rh__top">
        <noscript></noscript>
        <span class="rh__index">{r.index}</span>
        <div class="rh__titles">
          <span class="eyebrow">Rubrik</span>
          <h1 class="rh__name" data-reveal>{r.name}</h1>
        </div>
        <span class="rh__count">{posts.length} tulisan</span>
      </div>
      <div class="rh__quote">
        <p class="rh__tagline" data-reveal style="--d:.08s">
          <em>“{r.tagline}”</em>
          <span>{r.description}</span>
        </p>
      </div>
    </div>
    <div class="rh__marq" aria-hidden="true">{r.name} · {r.name} · {r.name} · {r.name} · {r.name}</div>
  </header>

  <!-- ═════════ ISI ═════════ -->
  <section class="section">
    <div class="wrap">
      {lead ? (
        <>
          <a href={`/tulisan/${lead.slug}`} class="rlead">
            <div class="rlead__img">
              <img src={lead.image} alt={lead.imageAlt} /
            width={imgW(lead.image)}
            height={imgH(lead.image)}
          />
              <span class="rlead__badge">Edisi Terbaru</span>
            </div>
            <div class="rlead__body">
              <span class="eyebrow">{formatDate(lead.date)} · {lead.reading} menit</span>
              <h2 class="rlead__title">{lead.title}</h2>
              <p class="rlead__suj">{lead.sujudul}</p>
              <p class="rlead__dek">{lead.dek}</p>
              <span class="rlead__more">Baca selengkapnya <span>→</span></span>
            </div>
          </a>

          <div class="rlist__head">
            <span class="eyebrow">Seluruh Tulisan</span>
            <span class="rlist__count">{posts.length - 1} lainnya dalam rubrik ini</span>
          </div>

          <div class="rlist">
            {rest.map((a) => (
              <a href={`/tulisan/${a.slug}`} class="ritem">
                <div class="ritem__img">
                  <img src={a.image} alt={a.imageAlt} loading="lazy" /
            width={imgW(a.image)}
            height={imgH(a.image)}
          />
                </div>
                <div class="ritem__body">
                  <span class="ritem__meta">{formatDate(a.date)} · {a.reading} mnt baca</span>
                  <h3 class="ritem__title">{a.title}</h3>
                  <p class="ritem__dek">{a.dek}</p>
                  <span class="ritem__tags">{a.tags.map((t) => `#${t}`).join('  ·  ')}</span>
                </div>
                <span class="ritem__arrow">→</span>
              </a>
            ))}
            {rest.length === 0 && (
              <div class="rlist__empty">
                <p>Rubrik ini baru dibuka. Tulisan pertama sedang disiapkan.</p>
                <a href="/" class="btn btn--ghost">Kembali ke beranda</a>
              </div>
            )}
          </div>
        </>
      ) : (
        <div class="rlist__empty">
          <p>Belum ada tulisan di rubrik ini.</p>
          <a href="/" class="btn btn--ghost">Kembali ke beranda</a>
        </div>
      )}

      <!-- iklan dalam -->
      <div class="radband">
        <AdSlot format="leaderboard" />
      </div>

      <!-- rail bawah: rubrik lain + iklan -->
      <div class="rfoot">
        <div>
          <span class="eyebrow">Rubrik Lain</span>
          <div class="rfoot__rubriks">
            {sibling.map((s) => (
              <a href={`/rubrik/${s.slug}`} class="rfoot__pill">
                <span class="rfoot__pidx">{s.index}</span>
                {s.name}
              </a>
            ))}
          </div>
        </div>
        <AdSlot format="square" />
      </div>

      <!-- juga menarik -->
      <div class="rfoot__more">
        <div class="rlist__head">
          <span class="eyebrow">Dari Rubrik Lain</span>
          <a href="/arsip" class="rlist__all">Arsip lengkap →</a>
        </div>
        <div class="rfoot__grid">
          {others.slice(0, 3).map((a) => (
            <ArticleCard article={a} variant="standard" />
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── header ── */
  .rh {
    position: relative;
    background: var(--ink);
    color: var(--paper);
    padding-top: clamp(2rem, 5vw, 3.75rem);
    overflow: hidden;
  }
  .rh .wrap { position: relative; z-index: 2; }
  .rh__top {
    display: flex;
    align-items: flex-end;
    gap: clamp(1rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--line-dark);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .rh__index {
    font-family: var(--serif-display);
    font-style: italic;
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--gold-600);
    flex: none;
  }
  .rh__titles .eyebrow { color: var(--gold-200); }
  .rh__name {
    font-family: var(--serif-display);
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin-top: 0.4rem;
  }
  .rh__count {
    margin-left: auto;
    font-family: var(--sans);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(244, 239, 228, 0.45);
    white-space: nowrap;
    padding-bottom: 0.4rem;
  }
  .rh__quote { padding-block: clamp(1.5rem, 3vw, 2.5rem); }
  .rh__tagline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 2rem;
  }
  .rh__tagline em {
    font-family: var(--serif-display);
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    color: var(--gold-200);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .rh__tagline span {
    flex: 1 1 320px;
    font-size: 0.98rem;
    line-height: 1.7;
    color: rgba(244, 239, 228, 0.58);
    max-width: 62ch;
  }
  .rh__marq {
    font-family: var(--serif-display);
    font-size: clamp(4rem, 15vw, 14rem);
    line-height: 0.72;
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(208, 175, 98, 0.13);
    white-space: nowrap;
    text-align: center;
    transform: translateY(18%);
    user-select: none;
    position: relative;
    z-index: 1;
  }

  /* ── lead ── */
  .rlead {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding-bottom: clamp(2rem, 4vw, 3.25rem);
    border-bottom: 1px solid var(--line);
  }
  .rlead__img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--ink-2);
  }
  .rlead__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s var(--ease-out);
    filter: saturate(0.92);
  }
  .rlead:hover .rlead__img img { transform: scale(1.04); filter: saturate(1); }
  .rlead__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--gold-600);
    color: var(--ivory);
    font-family: var(--sans);
    font-size: 0.55rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 0.45rem 0.8rem;
  }
  .rlead__body { display: flex; flex-direction: column; gap: 0.8rem; }
  .rlead__title {
    font-family: var(--serif-display);
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.022em;
    transition: color 0.35s;
  }
  .rlead:hover .rlead__title { color: var(--gold-700); }
  .rlead__suj {
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .rlead__dek { font-size: 0.95rem; line-height: 1.7; color: var(--ink-soft); max-width: 55ch; }
  .rlead__more {
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-700);
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    align-self: flex-start;
  }
  .rlead__more span { transition: transform 0.4s var(--ease-out); }
  .rlead:hover .rlead__more span { transform: translateX(5px); }

  /* ── list ── */
  .rlist__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(1.75rem, 3vw, 2.5rem) 0.9rem;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 0.5rem;
  }
  .rlist__count, .rlist__all {
    font-family: var(--sans);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .rlist__all:hover { color: var(--gold-700); }
  .rlist { display: flex; flex-direction: column; }
  .ritem {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) 24px;
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: center;
    padding-block: clamp(1.25rem, 2.5vw, 1.85rem);
    border-bottom: 1px solid var(--line);
    transition: background 0.4s;
  }
  .ritem:hover { background: rgba(208, 175, 98, 0.06); }
  .ritem__img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink-2);
  }
  .ritem__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: transform 1.3s var(--ease-out), filter 0.6s;
  }
  .ritem:hover .ritem__img img { transform: scale(1.06); filter: saturate(1); }
  .ritem__body { display: flex; flex-direction: column; gap: 0.4rem; }
  .ritem__meta {
    font-family: var(--sans);
    font-size: 0.56rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-700);
  }
  .ritem__title {
    font-family: var(--serif-display);
    font-size: clamp(1.3rem, 2.2vw, 1.85rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.015em;
    transition: color 0.3s;
  }
  .ritem:hover .ritem__title { color: var(--gold-700); }
  .ritem__dek {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--muted);
    max-width: 68ch;
  }
  .ritem__tags {
    font-family: var(--sans);
    font-size: 0.55rem;
    letter-spacing: 0.12em;
    color: var(--muted-2);
    margin-top: 0.15rem;
  }
  .ritem__arrow {
    color: var(--gold-600);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.35s, transform 0.4s var(--ease-out);
    font-size: 1.1rem;
  }
  .ritem:hover .ritem__arrow { opacity: 1; transform: none; }
  .rlist__empty {
    padding: 3rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: var(--muted);
    font-style: italic;
  }

  /* ── foot ── */
  .radband { padding-block: clamp(2rem, 4vw, 3rem); }
  .rfoot {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .rfoot__rubriks { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  .rfoot__pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    border: 1px solid var(--line);
    padding: 0.65em 1.1em;
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: background 0.35s, color 0.35s, border-color 0.35s;
  }
  .rfoot__pill:hover { background: var(--ink); color: var(--gold-200); border-color: var(--ink); }
  .rfoot__pidx {
    font-family: var(--serif-display);
    font-style: italic;
    font-size: 0.62rem;
    color: var(--gold-700);
    letter-spacing: 0;
    text-transform: none;
  }
  .rfoot__pill:hover .rfoot__pidx { color: var(--gold-200); }
  .rfoot__more { margin-top: clamp(2rem, 4vw, 3.5rem); }
  .rfoot__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .rlead { grid-template-columns: 1fr; }
    .ritem { grid-template-columns: 120px minmax(0, 1fr); }
    .ritem__arrow { display: none; }
    .rfoot { grid-template-columns: 1fr; }
    .rfoot__grid { grid-template-columns: 1fr; }
    .rh__top { flex-wrap: wrap; }
    .rh__count { margin-left: 0; }
  }
  @media (max-width: 560px) {
    .ritem { grid-template-columns: 1fr; }
    .ritem__img { aspect-ratio: 16 / 9; }
    .rh__index { font-size: 3rem; }
  }
</style>
