---
import Base from '../layouts/Base.astro';
import { latest } from '../data/articles.js';
import { site } from '../data/site.js';
const picks = latest.slice(0, 3);
---
<Base title="Halaman tidak ditemukan" description="Halaman yang Anda cari tidak ada di arsip kami." image="/og/404.jpg">
  <section class="nf">
    <div class="wrap nf__inner">
      <span class="nf__code">404</span>
      <span class="eyebrow eyebrow--light">Simpangan</span>
      <h1 class="nf__title">Halaman ini<br /><em>tidak ada di arsip.</em></h1>
      <p class="nf__desc">
        Mungkin tautannya telah berubah, atau tulisan itu belum ditulis.
        Sementara itu, tiga bacaan ini menunggu:
      </p>
      <div class="nf__links">
        {picks.map((a) => (
          <a href={`/tulisan/${a.slug}`} class="nf__link">
            <span class="nf__kicker">{a.rubrik}</span>
            <span class="nf__name">{a.title}</span>
          </a>
        ))}
      </div>
      <div class="nf__actions">
        <a href="/" class="btn btn--gold">Kembali ke beranda <span class="btn__arrow">→</span></a>
        <a href="/arsip" class="btn btn--light">Lihat arsip</a>
      </div>
      <p class="nf__contact">
        Atau hubungi redaksi di <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .nf { background: var(--ink); color: var(--paper); min-height: 78vh; display: grid; place-items: center; padding-block: 5rem; }
  .nf__inner { max-width: 800px; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .nf__code {
    font-family: var(--serif-display);
    font-size: clamp(6rem, 22vw, 15rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px rgba(208, 175, 98, 0.4);
    letter-spacing: 0.02em;
    margin-bottom: 1.5rem;
  }
  .nf__title {
    font-family: var(--serif-display);
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-block: 0.75rem 1rem;
  }
  .nf__title em { color: var(--gold-200); }
  .nf__desc { color: rgba(244, 239, 228, 0.58); max-width: 46ch; line-height: 1.7; }
  .nf__links { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-block: 2rem; }
  .nf__link {
    border: 1px solid var(--line-dark);
    padding: 1rem 1.25rem;
    max-width: 260px;
    text-align: left;
    transition: border-color 0.35s, background 0.35s;
  }
  .nf__link:hover { border-color: var(--gold-600); background: rgba(208, 175, 98, 0.06); }
  .nf__kicker { display: block; font-family: var(--sans); font-size: 0.5rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-200); margin-bottom: 0.35rem; }
  .nf__name { font-family: var(--serif-display); font-size: 1.05rem; line-height: 1.2; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
  .nf__contact { margin-top: 2rem; font-family: var(--sans); font-size: 0.62rem; letter-spacing: 0.12em; color: rgba(244, 239, 228, 0.46); }
  .nf__contact a { color: var(--gold-200); }
</style>
