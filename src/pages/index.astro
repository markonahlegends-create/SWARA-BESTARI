---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import SectionHead from '../components/SectionHead.astro';
import Marquee from '../components/Marquee.astro';
import ReadingList from '../components/ReadingList.astro';
import RubrikGrid from '../components/RubrikGrid.astro';
import QuoteBanner from '../components/QuoteBanner.astro';
import Contributors from '../components/Contributors.astro';
import NewsletterInline from '../components/NewsletterInline.astro';
import MostRead from '../components/MostRead.astro';
import PodcastStrip from '../components/PodcastStrip.astro';
import EditorsNote from '../components/EditorsNote.astro';
import Manifesto from '../components/Manifesto.astro';
import KronikBand from '../components/KronikBand.astro';
import { site } from '../data/site.js';
import { articles, latest, byRubrik, formatDate, shortDate } from '../data/articles.js';

const hero = articles.find((a) => a.slug === 'pasar-yang-menolak-digusur')!;
const side = [
  articles.find((a) => a.slug === 'keindahan-sebagai-perlawanan')!,
  articles.find((a) => a.slug === 'candi-yang-tenggelam-dalam-sawah')!,
  articles.find((a) => a.slug === 'kembali-ke-rumah-yang-tidak-ada')!,
];
const essay = articles.find((a) => a.slug === 'bahasa-yang-kehilangan-penutur')!;
const poetryFeature = articles.find((a) => a.slug === 'lukisan-yang-tidak-ingin-dijual')!;
const humaniora = byRubrik('humaniora');
const seni = byRubrik('seni');
const diskursus = byRubrik('diskursus');
const ticker = latest.slice(0, 6);
// Dimensi intrinsik gambar: mencegah layout shift saat gambar dimuat.
const IMG_SIZES: Record<string, [number, number]> = {'art-gallery.jpg':[1400,939],'cover-current.jpg':[900,1117],'diskursus-forum.jpg':[1400,939],'esai-library.jpg':[1000,1241],'hero-kronik.jpg':[1800,1005],'humaniora-hands.jpg':[1400,939],'jejak-archive.jpg':[1400,939],'khazanah-temple.jpg':[1600,1073],'poet-portrait.jpg':[900,1117],'seni-brush.jpg':[1400,939]};
const imgW = (src: string) => IMG_SIZES[String(src).split('/').pop() || '']?.[0];
const imgH = (src: string) => IMG_SIZES[String(src).split('/').pop() || '']?.[1];
---

<Base title={site.name} description={site.description} image="/og/beranda.jpg">
  <!-- ═════════ META STRIP ═════════ -->
  <div class="meta-strip">
    <div class="wrap meta-strip__inner">
      <span class="meta-strip__edition">Edisi No. 84 · November 2026</span>
      <span class="meta-strip__sep"></span>
      <span class="meta-strip__theme">Tema: <em>Yang Bertahan dan Yang Pergi</em></span>
      <span class="meta-strip__right">Vol. VII</span>
    </div>
  </div>

  <!-- ═════════ HERO ═════════ -->
  <section class="hero">
    <div class="wrap hero__grid">
      <!-- feature besar -->
      <article class="hero__lead" data-reveal>
        <a href={`/tulisan/${hero.slug}`} class="hero__imgwrap">
          <img src={hero.image} alt={hero.imageAlt} fetchpriority="high" /
            width={imgW(hero.image)}
            height={imgH(hero.image)}
          />
          <span class="hero__badge">Laporan Utama</span>
          <span class="hero__imgcaption">{hero.imageCredit}</span>
        </a>
        <div class="hero__body">
          <div class="hero__kicker">
            <span class="hero__rubrik">Kronik</span>
            <span class="hero__date">{formatDate(hero.date)} · {hero.reading} menit baca</span>
          </div>
          <h1 class="hero__title">
            <a href={`/tulisan/${hero.slug}`}>{hero.title}</a>
          </h1>
          <p class="hero__sujudul">{hero.sujudul}</p>
          <div class="hero__byline">
            <span class="hero__author">Oleh {hero.author}</span>
            <a href={`/tulisan/${hero.slug}`} class="hero__readmore">
              Baca laporan <span>→</span>
            </a>
          </div>
        </div>
      </article>

      <!-- kolom kanan -->
      <div class="hero__side">
        <div class="hero__side-head">
          <span class="eyebrow">Juga di Edisi Ini</span>
        </div>
        {side.map((a, i) => (
          <article class="hero__sideitem" data-reveal style={`--d:${0.08 * (i + 1)}s`}>
            <a href={`/tulisan/${a.slug}`} class="hero__sideimg">
              <img src={a.image} alt={a.imageAlt} loading="lazy" /
            width={imgW(a.image)}
            height={imgH(a.image)}
          />
            </a>
            <div class="hero__sidebody">
              <span class="hero__siderubrik">{a.rubrik === 'esai' ? 'Esai' : a.rubrik === 'khazanah' ? 'Khazanah' : 'Humaniora'}</span>
              <h3 class="hero__sidetitle"><a href={`/tulisan/${a.slug}`}>{a.title}</a></h3>
              <span class="hero__sidemeta">{a.author} · {a.reading} mnt</span>
            </div>
          </article>
        ))}
        <a href="/arsip" class="hero__all">Seluruh isi edisi <span>→</span></a>
      </div>
    </div>
  </section>

  <!-- ═════════ TICKER ═════════ -->
  <div class="ticker" role="region" aria-label="Terkini">
    <div class="ticker__label">
      <span class="ticker__dot"></span>
      Terkini
    </div>
    <div class="ticker__viewport">
      <div class="ticker__track">
        {[...ticker, ...ticker].map((a) => (
          <a class="ticker__item" href={`/tulisan/${a.slug}`}>
            <span class="ticker__time">{shortDate(a.date)}</span>
            <span class="ticker__title">{a.title}</span>
            <span class="ticker__sep">/</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ═════════ BILLBOARD AD ═════════ -->
  <div class="wrap adband">
    <AdSlot format="billboard" />
  </div>

  <!-- ═════════ KURASI UTAMA ═════════ -->
  <section class="section curation">
    <div class="wrap">
      <SectionHead
        eyebrow="Pilihan Redaksi"
        title="Yang Patut Dibaca Pekan Ini"
        link="/arsip"
        linkLabel="Arsip lengkap"
        index="I"
      />
      <div class="curation__grid">
        <!-- esai besar -->
        <article class="curation__essay" data-reveal>
          <a href={`/tulisan/${essay.slug}`} class="curation__img">
            <img src={essay.image} alt={essay.imageAlt} loading="lazy" /
            width={imgW(essay.image)}
            height={imgH(essay.image)}
          />
          </a>
          <span class="eyebrow">Esai · {formatDate(essay.date)}</span>
          <h3 class="curation__title">
            <a href={`/tulisan/${essay.slug}`}>{essay.title}</a>
          </h3>
          <p class="curation__dek">{essay.sujudul}</p>
          <p class="curation__excerpt">{essay.excerpt}</p>
          <a href={`/tulisan/${essay.slug}`} class="curation__more">Baca esai <span>→</span></a>
        </article>

        <!-- daftar -->
        <div class="curation__list">
          <span class="curation__listhead">Dalam Rubrik</span>
          {byRubrik('esai').concat(byRubrik('diskursus')).slice(0, 4).map((a, i) => (
            <a href={`/tulisan/${a.slug}`} class="curation__row" data-reveal style={`--d:${0.06 * i}s`}>
              <span class="curation__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="curation__rowbody">
                <span class="curation__rowkicker">{a.rubrik === 'esai' ? 'Esai' : 'Diskursus'}</span>
                <span class="curation__rowtitle">{a.title}</span>
                <span class="curation__rowmeta">{a.author} · {a.reading} mnt baca</span>
              </span>
              <span class="curation__rowarrow">→</span>
            </a>
          ))}
          <AdSlot format="compact" class="curation__ad" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ KRONIK BAND ═════════ -->
  <KronikBand />

  <Marquee />

  <!-- ═════════ SURAT REDAKSI ═════════ -->
  <EditorsNote />

  <!-- ═════════ AD LEADERBOARD ═════════ -->
  <div class="wrap adband">
    <AdSlot format="leaderboard" />
  </div>

  <!-- ═════════ SENI — feature gelap ═════════ -->
  <section class="dark-band">
    <div class="wrap">
      <SectionHead
        eyebrow="Rubrik Seni"
        title="Mata yang Dilatih Melihat"
        link="/rubrik/seni"
        index="II"
        tone="dark"
      />
      <div class="artgrid">
        <article class="artgrid__lead" data-reveal>
          <a href={`/tulisan/${poetryFeature.slug}`} class="artgrid__img">
            <img src={poetryFeature.image} alt={poetryFeature.imageAlt} loading="lazy" /
            width={imgW(poetryFeature.image)}
            height={imgH(poetryFeature.image)}
          />
          </a>
          <div class="artgrid__body">
            <h3 class="artgrid__title">
              <a href={`/tulisan/${poetryFeature.slug}`}>{poetryFeature.title}</a>
            </h3>
            <p>{poetryFeature.sujudul}</p>
            <span class="artgrid__meta">{poetryFeature.author} · {formatDate(poetryFeature.date)}</span>
          </div>
        </article>
        <div class="artgrid__side">
          {seni.slice(1).concat(diskursus.slice(0, 1)).map((a, i) => (
            <a href={`/tulisan/${a.slug}`} class="artgrid__item" data-reveal style={`--d:${0.07 * i}s`}>
              <div class="artgrid__thumb">
                <img src={a.image} alt={a.imageAlt} loading="lazy" /
            width={imgW(a.image)}
            height={imgH(a.image)}
          />
              </div>
              <div>
                <span class="artgrid__kicker">{a.rubrik === 'seni' ? 'Seni' : 'Diskursus'}</span>
                <h4>{a.title}</h4>
                <span class="artgrid__meta">{a.reading} mnt baca</span>
              </div>
            </a>
          ))}
          <AdSlot format="square" tone="dark" class="artgrid__ad" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ MANIFESTO ═════════ -->
  <Manifesto />

  <!-- ═════════ HUMANIONA + SIDEBAR ═════════ -->
  <section class="section">
    <div class="wrap hub">
      <div class="hub__main">
        <SectionHead
          eyebrow="Humaniora"
          title="Manusia, dan Ketidakrapiannya"
          link="/rubrik/humaniora"
          index="III"
        />
        <div class="hub__lead" data-reveal>
          <a href={`/tulisan/${humaniora[0].slug}`} class="hub__leadimg">
            <img src={humaniora[0].image} alt={humaniora[0].imageAlt} loading="lazy" /
            width={imgW(humaniora[0].image)}
            height={imgH(humaniora[0].image)}
          />
          </a>
          <div class="hub__leadbody">
            <h3><a href={`/tulisan/${humaniora[0].slug}`}>{humaniora[0].title}</a></h3>
            <p>{humaniora[0].sujudul}</p>
            <span class="hub__leadmeta">{humaniora[0].author} · {humaniora[0].reading} mnt baca</span>
          </div>
        </div>
        <div class="hub__two">
          {humaniora.slice(1).map((a, i) => (
            <ArticleCard article={a} variant="standard" />
          ))}
        </div>
      </div>

      <aside class="hub__rail">
        <MostRead />
        <AdSlot format="halfpage" />
        <ReadingList />
      </aside>
    </div>
  </section>

  <!-- ═════════ QUOTE BANNER ═════════ -->
  <QuoteBanner />

  <!-- ═════════ RUBRIK GRID ═════════ -->
  <section class="section rubriks">
    <div class="wrap">
      <SectionHead eyebrow="Enam Rubrik" title="Peta Isi Swara Bestari" index="IV" link="/arsip" />
      <RubrikGrid />
    </div>
  </section>

  <!-- ═════════ NATIVE AD ═════════ -->
  <div class="wrap adband">
    <AdSlot format="native" label="Mata Surat" />
  </div>

  <!-- ═════════ PODCAST + NEWSLETTER ═════════ -->
  <section class="section extras">
    <div class="wrap extras__grid">
      <PodcastStrip />
      <NewsletterInline />
    </div>
  </section>

  <!-- ═════════ KONTRIBUTOR ═════════ -->
  <Contributors />

  <!-- ═════════ AD STRIP ═════════ -->
  <div class="wrap adband adband--last">
    <AdSlot format="strip" />
  </div>
</Base>

<style>
  /* ── meta strip ── */
  .meta-strip {
    border-bottom: 1px solid var(--line-soft);
    background: var(--paper);
  }
  .meta-strip__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.7rem;
    font-family: var(--sans);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .meta-strip__sep {
    width: 18px;
    height: 1px;
    background: var(--gold-600);
    opacity: 0.5;
  }
  .meta-strip__theme em {
    font-family: var(--serif-body);
    font-style: italic;
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-soft);
  }
  .meta-strip__right { margin-left: auto; color: var(--gold-700); }

  /* ── hero ── */
  .hero { padding-top: clamp(2rem, 4vw, 3.25rem); }
  .hero__lead { padding-top: 0; }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .hero__lead { display: flex; flex-direction: column; gap: 1.75rem; }
  .hero__imgwrap {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    aspect-ratio: 16 / 10;
    outline: 1px solid var(--gold);
    outline-offset: 8px;
  }
  .hero__imgwrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease-out), filter 1s;
    filter: saturate(0.9) contrast(1.02);
  }
  .hero__imgwrap:hover img { transform: scale(1.03); filter: saturate(1); }
  .hero__imgwrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 18, 15, 0.35), transparent 45%);
    pointer-events: none;
  }
  /* bingkai museum: garis emas tipis di dalam foto */
  .hero__imgwrap::before {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(225, 197, 119, 0.35);
    z-index: 2;
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .hero__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    background: var(--gold-600);
    color: var(--ivory);
    font-family: var(--sans);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    padding: 0.5rem 0.85rem;
  }
  .hero__imgcaption {
    position: absolute;
    bottom: 0.85rem;
    right: 1rem;
    z-index: 2;
    font-family: var(--sans);
    font-size: 0.55rem;
    letter-spacing: 0.12em;
    color: rgba(244, 239, 228, 0.55);
  }
  .hero__body { display: flex; flex-direction: column; gap: 0.95rem; }
  .hero__kicker { display: flex; align-items: center; gap: 1rem; }
  .hero__rubrik {
    font-family: var(--sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-700);
    padding-right: 1rem;
    border-right: 1px solid var(--line);
  }
  .hero__date {
    font-family: var(--sans);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .hero__title {
    font-family: var(--serif-display);
    font-size: clamp(2.1rem, 4.6vw, 3.9rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.025em;
    max-width: 16ch;
  }
  .hero__title a { transition: color 0.4s var(--ease); }
  .hero__title a:hover { color: var(--gold-700); }
  .hero__sujudul {
    font-size: clamp(1rem, 1.3vw, 1.16rem);
    line-height: 1.6;
    color: var(--muted);
    max-width: 52ch;
    font-style: italic;
  }
  .hero__byline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-soft);
  }
  .hero__author {
    font-family: var(--sans);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .hero__readmore {
    font-family: var(--sans);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-700);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero__readmore span { transition: transform 0.4s var(--ease-out); }
  .hero__readmore:hover span { transform: translateX(5px); }

  /* ── hero side ── */
  .hero__side {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
    padding-left: clamp(0rem, 2.5vw, 2.5rem);
  }
  .hero__side-head {
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .hero__sideitem {
    display: flex;
    gap: 1rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--line-soft);
    align-items: flex-start;
  }
  .hero__sideimg {
    flex: none;
    width: 92px;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--ink-2);
  }
  .hero__sideimg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
    filter: saturate(0.9);
  }
  .hero__sideitem:hover .hero__sideimg img { transform: scale(1.08); filter: saturate(1); }
  .hero__sidebody { display: flex; flex-direction: column; gap: 0.3rem; }
  .hero__siderubrik {
    font-family: var(--sans);
    font-size: 0.55rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-700);
  }
  .hero__sidetitle {
    margin: 0;
    font-family: var(--serif-display);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.01em;
  }
  .hero__sidetitle a { transition: color 0.35s; }
  .hero__sideitem:hover .hero__sidetitle a { color: var(--gold-700); }
  .hero__sidemeta {
    font-family: var(--sans);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .hero__all {
    margin-top: 1.1rem;
    font-family: var(--sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }
  .hero__all span { transition: transform 0.4s var(--ease-out); }
  .hero__all:hover span { transform: translateX(5px); }

  /* ── ticker ── */
  .ticker {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    border-block: 1px solid var(--line);
    display: flex;
    align-items: stretch;
    background: var(--paper-2);
    overflow: hidden;
  }
  .ticker__label {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: var(--gutter) 1rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
    padding-right: 1.9rem;
  }
  .ticker__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
    animation: pulse2 2.2s infinite;
  }
  @keyframes pulse2 {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }
  .ticker__viewport { flex: 1; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 3%, #000 94%, transparent); }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: tick 38s linear infinite;
  }
  .ticker__track:hover { animation-play-state: paused; }
  @keyframes tick { to { transform: translateX(-50%); } }
  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.25rem;
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    white-space: nowrap;
    transition: color 0.3s;
  }
  .ticker__item:hover { color: var(--gold-700); }
  .ticker__time { color: var(--gold-700); font-size: 0.6rem; letter-spacing: 0.14em; }
  .ticker__sep { color: var(--line); margin-left: 0.6rem; }

  /* ── ad band ── */
  .adband { padding-block: clamp(1.75rem, 3.5vw, 2.75rem); }
  .adband--last { padding-bottom: clamp(3rem, 6vw, 5rem); }

  /* ── curation ── */
  .curation__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
  }
  .curation__essay { display: flex; flex-direction: column; gap: 0.85rem; }
  .curation__img {
    overflow: hidden;
    aspect-ratio: 16 / 11;
    background: var(--ink-2);
    margin-bottom: 0.35rem;
  }
  .curation__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s var(--ease-out);
    filter: saturate(0.88);
  }
  .curation__img:hover img { transform: scale(1.04); filter: saturate(1); }
  .curation__title {
    font-family: var(--serif-display);
