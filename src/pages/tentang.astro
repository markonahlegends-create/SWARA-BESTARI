---
import Base from '../layouts/Base.astro';
import { site, rubrik } from '../data/site.js';
---

<Base
  title="Tentang Kami"
  description="Swara Bestari adalah majalah digital seni, kebudayaan, dan pemikiran yang terbit sejak 2019."
>
  <!-- ═════════ PEMBUKA ═════════ -->
  <header class="ab">
    <div class="wrap ab__inner">
      <span class="eyebrow eyebrow--light">Tentang</span>
      <h1 class="ab__title">
        Kami menulis pelan,<br />
        karena pembaca kami <em>meluangkan waktu.</em>
      </h1>
      <p class="ab__lead">
        Swara Bestari lahir pada 2019 sebagai surat kabar bulanan fotokopian di Yogyakarta.
        Enam tahun kemudian, ia telah menjadi ruang bagi penulis, peneliti, seniman, dan
        pembaca yang percaya bahwa kebudayaan layak dibicarakan dengan serius—tanpa
        kehilangan rasa ingin tahu.
      </p>
    </div>
    <div class="ab__mark" aria-hidden="true">SWARA</div>
  </header>

  <!-- ═════════ NILAI ═════════ -->
  <section class="section">
    <div class="wrap">
      <div class="vx__head">
        <span class="eyebrow">Yang Kami Pegang</span>
        <h2 class="vx__title">Empat prinsip yang tidak kami tawar</h2>
      </div>
      <div class="vx">
        {[
          {
            i: '01',
            t: 'Panjang bukan kelemahan',
            d: 'Kami tidak memotong gagasan agar sesuai dengan rentang perhatian terpendek. Tulisan yang membutuhkan dua belas menit akan mendapat dua belas menit—atau tidak terbit sama sekali.',
          },
          {
            i: '02',
            t: 'Ketelitian sebelum kecepatan',
            d: 'Setiap artikel melewati minimal dua penyunting dan satu pemeriksa fakta. Kami lebih suka terbit terlambat daripada menyebarkan kesalahan yang rapi.',
          },
          {
            i: '03',
            t: 'Suara dari pinggir',
            d: 'Kami aktif mencari penulis dari luar Jawa, dari disiplin yang jarang terdengar, dan dari generasi yang belum punya nama. Bukan sebagai kuota—sebagai koreksi terhadap diri sendiri.',
          },
          {
            i: '04',
            t: 'Transparan soal uang',
            d: 'Iklan dan kemitraan diberi label. Kami menerbitkan laporan keuangan ringkas setiap tahun. Pembaca berhak tahu siapa yang membayar apa.',
          },
        ].map((v, idx) => (
          <article class="vx__item" data-reveal style={`--d:${idx * 0.06}s`}>
            <span class="vx__num">{v.i}</span>
            <h3 class="vx__name">{v.t}</h3>
            <p class="vx__desc">{v.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════ SEJARAH ═════════ -->
  <section class="tl">
    <div class="wrap">
      <span class="eyebrow">Jejak Waktu</span>
      <h2 class="tl__title">Tujuh tahun, satu suara</h2>
      <ol class="tl__list">
        {[
          ['2019', 'Edisi pertama', 'Dua belas halaman fotokopian, dicetak 200 eksemplar, disebar di kafe dan kampus Yogyakarta.'],
          ['2020', 'Berpindah ke layar', 'Pandemi memaksa kami menutup cetak. Situs pertama kami dibuka dengan lima tulisan.'],
          ['2021', 'Rubrik Khazanah', 'Kami mulai membawa peneliti arkeologi dan filologi sebagai kontributor tetap.'],
          ['2022', 'Pertama kali berbayar', 'Tiga editor penuh waktu pertama; sebelum itu semuanya sukarela.'],
          ['2023', 'Jaringan penulis tamu', 'Lebih dari empat puluh penulis dari sembilan provinsi bergabung.'],
          ['2024', 'Podcast & arsip digital', 'Suara dari Balik Halaman dimulai; seluruh arsip cetak didigitasi.'],
          ['2026', 'Rubrik Humaniora', 'Rubrik keenam dibuka, menandai pergeseran dari kritik budaya ke sains manusia.'],
        ].map(([yr, t, d], i) => (
          <li class="tl__item" data-reveal style={`--d:${i * 0.05}s`}>
            <span class="tl__year">{yr}</span>
            <div class="tl__body">
              <h3>{t}</h3>
              <p>{d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═════════ RUBRIK ═════════ -->
  <section class="section rb">
    <div class="wrap">
      <span class="eyebrow">Rubrik</span>
      <h2 class="rb__title">Enam pintu masuk</h2>
      <div class="rb__grid">
        {rubrik.map((r) => (
          <a href={`/rubrik/${r.slug}`} class="rb__card">
            <span class="rb__idx">{r.index}</span>
            <h3>{r.name}</h3>
            <p>{r.description}</p>
            <span class="rb__more">Masuk →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════ PEDOMAN ═════════ -->
  <section class="section pd" id="pedoman">
    <div class="wrap pd__inner">
      <div class="pd__head">
        <span class="eyebrow">Pedoman</span>
        <h2 class="pd__title">Pedoman media & <em>koreksi</em></h2>
        <p>
          Kami mengikuti Kode Etik Jurnalistik dan Pedoman Pemberitaan Media Siber.
          Kesalahan yang kami buat akan kami koreksi secara terbuka di bagian bawah
          artikel yang bersangkutan—bukan dihapus diam-diam.
        </p>
        <a href="#kontak" class="btn btn--ghost">Laporkan kesalahan <span class="btn__arrow">→</span></a>
      </div>
      <div class="pd__cols">
        <div class="pd__col">
          <h3>Verifikasi</h3>
          <ul>
            <li>Setiap klaim faktual diperiksa terhadap minimal dua sumber independen.</li>
            <li>Kutipan dikonfirmasi kepada narasumber sebelum terbit.</li>
            <li>Foto dan ilustrasi diberi kredit dan keterangan.</li>
            <li>Penggunaan kecerdasan artifisial dalam penulisan wajib diungkapkan.</li>
          </ul>
        </div>
        <div class="pd__col">
          <h3>Independensi</h3>
          <ul>
            <li>Redaksi tidak menerima instruksi dari pemasang iklan.</li>
            <li>Konten berbayar selalu berlabel “Mata Surat”.</li>
            <li>Penulis tidak menerima hadiah atau fasilitas dari pihak yang diliput.</li>
            <li>Konflik kepentingan diumumkan di akhir artikel.</li>
          </ul>
        </div>
        <div class="pd__col" id="privasi">
          <h3>Privasi</h3>
          <ul>
            <li>Kami tidak menjual data pembaca kepada pihak ketiga.</li>
            <li>Analitik menggunakan data agregat tanpa identitas pribadi.</li>
            <li>Surel pelanggan newsletter hanya dipakai untuk Surat Swara.</li>
            <li>Permintaan penghapusan data ditanggapi dalam 7 hari kerja.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ KONTAK ═════════ -->
  <section class="section kt" id="kontak">
    <div class="wrap kt__inner">
      <div>
        <span class="eyebrow eyebrow--light">Kontak</span>
        <h2 class="kt__title">Ada yang ingin<br /><em>Anda sampaikan?</em></h2>
        <p class="kt__desc">
          Kirimkan tulisan, usulan liputan, koreksi, atau sekadar sapaan.
          Semua pesan dibaca oleh manusia.
        </p>
      </div>
      <div class="kt__card">
        <a class="kt__phone" href={`tel:${site.phoneHref}`}>{site.phone}</a>
        <span class="kt__sub">Telepon & WhatsApp redaksi</span>
        <div class="kt__divider"></div>
        <div class="kt__rows">
          <div>
            <span class="kt__label">Redaksi umum</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div>
            <span class="kt__label">Iklan & kemitraan</span>
            <a href="mailto:iklan@swarabestari.id">iklan@swarabestari.id</a>
          </div>
          <div>
            <span class="kt__label">Kirim tulisan</span>
            <a href="mailto:tulisan@swarabestari.id">tulisan@swarabestari.id</a>
          </div>
          <div>
            <span class="kt__label">Sekretariat</span>
            <span class="kt__muted">{site.address}</span>
          </div>
        </div>
        <a class="btn btn--gold kt__btn" href={site.whatsapp} target="_blank" rel="noopener">
          WhatsApp redaksi <span class="btn__arrow">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── pembuka ── */
  .ab { position: relative; background: var(--ink); color: var(--paper); overflow: hidden; padding-top: clamp(2.75rem, 6vw, 5.5rem); }
  .ab::before {
    content: '';
    position: absolute;
    left: -10%;
    top: -20%;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(208, 175, 98, 0.12), transparent 62%);
  }
  .ab__inner { position: relative; z-index: 2; max-width: 62ch; }
  .ab__title {
    font-family: var(--serif-display);
    font-size: clamp(2.3rem, 5.4vw, 4.2rem);
    font-weight: 500;
    line-height: 1.0;
    letter-spacing: -0.028em;
    margin-block: 1rem 1.5rem;
  }
  .ab__title em { color: var(--gold-200); }
  .ab__lead {
    font-size: clamp(1rem, 1.4vw, 1.14rem);
    line-height: 1.75;
    color: rgba(244, 239, 228, 0.62);
  }
  .ab__mark {
    font-family: var(--serif-display);
    font-size: clamp(4rem, 17vw, 15rem);
    line-height: 0.7;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1px rgba(208, 175, 98, 0.15);
    transform: translateY(28%);
    letter-spacing: 0.04em;
    user-select: none;
    margin-top: 2rem;
  }

  /* ── nilai ── */
  .vx__head { max-width: 56ch; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .vx__title {
    font-family: var(--serif-display);
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.022em;
    margin-top: 0.65rem;
  }
  .vx {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .vx__item { background: var(--paper); padding: clamp(1.5rem, 3vw, 2.4rem); transition: background 0.4s; }
  .vx__item:hover { background: var(--paper-2); }
  .vx__num { font-family: var(--serif-display); font-style: italic; color: var(--gold-600); font-size: 0.95rem; }
  .vx__name { font-family: var(--serif-display); font-size: clamp(1.3rem, 2vw, 1.6rem); font-weight: 500; margin-block: 0.55rem 0.5rem; letter-spacing: -0.012em; }
  .vx__desc { font-size: 0.94rem; line-height: 1.7; color: var(--muted); max-width: 48ch; }

  /* ── timeline ── */
  .tl { background: var(--paper-2); border-block: 1px solid var(--line); padding-block: clamp(3rem, 6vw, 5rem); }
  .tl__title {
    font-family: var(--serif-display);
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.022em;
    margin-block: 0.65rem 2rem;
  }
  .tl__list { list-style: none; padding: 0; border-top: 1px solid var(--ink); }
  .tl__item {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .tl__year { font-family: var(--serif-display); font-size: clamp(1.3rem, 2.4vw, 1.8rem); color: var(--gold-700); letter-spacing: -0.01em; }
  .tl__body h3 { font-family: var(--serif-display); font-size: clamp(1.15rem, 1.7vw, 1.4rem); font-weight: 500; margin-bottom: 0.3rem; }
  .tl__body p { font-size: 0.92rem; line-height: 1.65; color: var(--muted); max-width: 62ch; }

  /* ── rubrik ── */
  .rb__title {
    font-family: var(--serif-display);
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.022em;
    margin-block: 0.65rem 2rem;
  }
  .rb__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 1.75rem); }
  .rb__card {
    border: 1px solid var(--line);
    padding: clamp(1.4rem, 2.6vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: background 0.4s, color 0.4s, transform 0.5s var(--ease-out);
  }
  .rb__card:hover { background: var(--ink); color: var(--paper); transform: translateY(-3px); }
  .rb__idx { font-family: var(--sans); font-size: 0.55rem; letter-spacing: 0.2em; color: var(--gold-700); }
  .rb__card:hover .rb__idx { color: var(--gold-200); }
  .rb__card h3 { font-family: var(--serif-display); font-size: 1.55rem; font-weight: 500; letter-spacing: -0.01em; }
  .rb__card p { font-size: 0.87rem; line-height: 1.65; color: var(--muted); flex: 1; }
  .rb__card:hover p { color: rgba(244, 239, 228, 0.55); }
  .rb__more { font-family: var(--sans); font-size: 0.56rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-700); margin-top: 0.5rem; }
  .rb__card:hover .rb__more { color: var(--gold-200); }

  /* ── pedoman ── */
  .pd__inner { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .pd__title {
    font-family: var(--serif-display);
    font-size: clamp(1.9rem, 3.6vw, 2.7rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.022em;
    margin-block: 0.65rem 1rem;
  }
  .pd__title em { color: var(--gold-700); }
  .pd__head p { font-size: 0.96rem; line-height: 1.7; color: var(--muted); margin-bottom: 1.5rem; max-width: 44ch; }
  .pd__cols { display: flex; flex-direction: column; }
  .pd__col { padding-block: 1.25rem; border-top: 1px solid var(--line); }
  .pd__col h3 { font-family: var(--serif-display); font-size: 1.3rem; font-weight: 500; margin-bottom: 0.75rem; }
  .pd__col ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .pd__col li {
    font-size: 0.89rem;
    line-height: 1.6;
    color: var(--muted);
    padding-left: 1.1rem;
    position: relative;
  }
  .pd__col li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    transform: rotate(45deg);
    background: var(--gold);
  }

  /* ── kontak ── */
  .kt { background: var(--ink); color: var(--paper); }
  .kt__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .kt__title {
    font-family: var(--serif-display);
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.024em;
    margin-block: 0.8rem 1rem;
  }
  .kt__title em { color: var(--gold-200); }
  .kt__desc { color: rgba(244, 239, 228, 0.55); max-width: 42ch; line-height: 1.7; }
  .kt__card { background: var(--ink-2); border: 1px solid var(--line-dark); padding: clamp(1.5rem, 3vw, 2.4rem); }
  .kt__phone { display: block; font-family: var(--serif-display); font-size: clamp(1.5rem, 2.6vw, 2rem); color: var(--gold-200); letter-spacing: 0.01em; transition: color 0.3s; }
  .kt__phone:hover { color: var(--paper); }
  .kt__sub { font-family: var(--sans); font-size: 0.56rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(244, 239, 228, 0.46); }
  .kt__divider { height: 1px; background: var(--line-dark); margin-block: 1.25rem; }
  .kt__rows { display: flex; flex-direction: column; gap: 1rem; }
  .kt__rows > div { display: flex; flex-direction: column; gap: 0.2rem; }
  .kt__label { font-family: var(--sans); font-size: 0.52rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(244, 239, 228, 0.46); }
  .kt__rows a { font-size: 0.95rem; color: var(--paper); transition: color 0.3s; }
  .kt__rows a:hover { color: var(--gold-200); }
  .kt__muted { font-size: 0.9rem; color: rgba(244, 239, 228, 0.55); }
  .kt__btn { margin-top: 1.5rem; width: 100%; justify-content: center; }

  @media (max-width: 900px) {
    .vx, .rb__grid, .pd__inner, .kt__inner { grid-template-columns: 1fr; }
    .tl__item { grid-template-columns: 60px 1fr; }
  }
</style>
