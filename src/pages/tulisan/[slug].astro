---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import RelatedInline from '../../components/RelatedInline.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import { articles, bySlug, related, formatDate } from '../../data/articles.js';
import { rubrikBySlug, site } from '../../data/site.js';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}

const { article } = Astro.props as { article: any };
const r = rubrikBySlug[article.rubrik];
const rel = related(article, 3);
const all = bySlug[article.slug];

// daftar isi dari subjudul
const slugify = (t: string) =>
  t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
   .replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-');
const toc = article.body
  .filter((b: any) => b.type === 'h2')
  .map((b: any) => ({ id: slugify(b.text), text: b.text }));

// saring blok isi, selipkan iklan setelah paragraf ke-3
const body = article.body;
const inserted: any[] = [];
let paraCount = 0;
let adInserted = false;
for (const block of body) {
  inserted.push(block);
  if (block.type === 'p') {
    paraCount++;
    if (paraCount === 3 && !adInserted) {
      inserted.push({ type: 'ad' });
      adInserted = true;
    }
    if (paraCount === 5) {
      inserted.push({ type: 'related' });
    }
  }
}
// Dimensi intrinsik gambar: mencegah layout shift saat gambar dimuat.
const IMG_SIZES: Record<string, [number, number]> = {'art-gallery.jpg':[1400,939],'cover-current.jpg':[900,1117],'diskursus-forum.jpg':[1400,939],'esai-library.jpg':[1000,1241],'hero-kronik.jpg':[1800,1005],'humaniora-hands.jpg':[1400,939],'jejak-archive.jpg':[1400,939],'khazanah-temple.jpg':[1600,1073],'poet-portrait.jpg':[900,1117],'seni-brush.jpg':[1400,939]};
const imgW = (src: string) => IMG_SIZES[String(src).split('/').pop() || '']?.[0];
const imgH = (src: string) => IMG_SIZES[String(src).split('/').pop() || '']?.[1];
---

<Base
  title={article.title}
  description={article.dek}
  image={`/og/${article.slug}.jpg`}
  article={true}
  published={new Date(article.date + 'T09:00:00+07:00').toISOString()}
  author={article.author}
>
  <!-- ═════════ HEADER ARTIKEL ═════════ -->
  <header class="ah">
    <div class="ah__bg" aria-hidden="true">
      <img src={article.image} alt="" /
            width={imgW(article.image)}
            height={imgH(article.image)}
          />
    </div>
    <div class="wrap wrap--narrow ah__inner">
      <nav class="crumbs" aria-label="Jejak">
        <a href="/">Beranda</a>
        <span>/</span>
        <a href={`/rubrik/${r.slug}`}>{r.name}</a>
      </nav>

      <h1 class="ah__title" data-reveal>{article.title}</h1>
      <p class="ah__sujudul" data-reveal style="--d:.08s">{article.sujudul}</p>

      <div class="ah__meta" data-reveal style="--d:.14s">
        <span class="ah__author">
          <span class="ah__initial">{article.author.charAt(0)}</span>
          {article.author}
        </span>
        <span class="ah__dot"></span>
        <span>{article.authorRole}</span>
        <span class="ah__dot"></span>
        <time datetime={article.date}>{formatDate(article.date)}</time>
        <span class="ah__dot"></span>
        <span>{article.reading} menit baca</span>
      </div>
    </div>
  </header>

  <!-- ═════════ GAMBAR UTAMA ═════════ -->
  <figure class="ahero">
    <div class="ahero__frame">
      <img src={article.image} alt={article.imageAlt} fetchpriority="high" /
            width={imgW(article.image)}
            height={imgH(article.image)}
          />
    </div>
    <figcaption class="wrap wrap--narrow ahero__cap">
      <span>{article.imageAlt}</span>
      <span class="ahero__credit">{article.imageCredit}</span>
    </figcaption>
  </figure>

  <!-- ═════════ TUBUH ═════════ -->
  <div class="wrap awrap">
    <div class="alayout">
      <!-- rail kiri: berbagi -->
      <aside class="ashare" aria-label="Bagikan & simpan">
        <span class="ashare__label">Bagikan</span>
        <a class="ashare__btn" href={`https://wa.me/?text=${encodeURIComponent(article.title)}`} target="_blank" rel="noopener" aria-label="Bagikan ke WhatsApp">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4c1.45.79 3.08 1.2 4.68 1.2 5.44 0 9.84-4.4 9.84-9.84S17.48 2 12.04 2zm5.7 13.9c-.24.68-1.4 1.3-1.94 1.35-.54.05-1.04.24-3.5-.73-2.95-1.17-4.8-4.2-4.95-4.4-.14-.2-1.18-1.58-1.18-3 0-1.44.75-2.14 1.02-2.44.26-.3.57-.36.76-.36h.55c.17 0 .4-.07.63.48.24.57.8 1.97.87 2.11.07.14.12.3.02.5-.1.2-.15.3-.3.47-.14.17-.3.38-.43.5-.15.14-.3.3-.13.6.17.29.75 1.24 1.62 2 1.12 1 2.06 1.3 2.35 1.45.3.14.47.12.64-.08.17-.2.73-.86.93-1.15.2-.3.4-.24.66-.15.27.1 1.7.8 2 .94.29.15.48.22.55.34.07.13.07.75-.17 1.43z"/></svg>
        </a>
        <a class="ashare__btn" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}`} target="_blank" rel="noopener" aria-label="Bagikan ke X">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.5 8.6L23 22h-6.9l-5.4-7-6.2 7H1.4l8-9.2L1 2h7.1l4.9 6.4L18.9 2zm-2.4 18h1.9L7.6 4H5.6l10.9 16z"/></svg>
        </a>
        <a class="ashare__btn" href={`https://www.facebook.com/sharer/sharer.php?u=`} target="_blank" rel="noopener" aria-label="Bagikan ke Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>
        </a>
        <a class="ashare__btn" href={`mailto:?subject=${encodeURIComponent(article.title)}`} aria-label="Kirim lewat surel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/></svg>
        </a>
        <button class="ashare__btn ashare__btn--save" id="save-btn" data-slug={article.slug} aria-label="Simpan tulisan" aria-pressed="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21z"/></svg>
          <span class="ashare__saved" aria-hidden="true">✓</span>
        </button>
        <button class="ashare__btn" id="reader-theme" aria-label="Ubah mode baca">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
        </button>
        <a class="ashare__btn" href={site.whatsapp} target="_blank" rel="noopener" aria-label="Hubungi redaksi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
        </a>
      </aside>

      <!-- artikel -->
      <article class="aprose" id="prose">
        <p class="alede">{article.dek}</p>

        {toc.length >= 2 && <ArticleToc items={toc} />}

        {inserted.map((block, bi) => {
          if (block.type === 'p') return <p>{block.text}</p>;
          if (block.type === 'h2') return <h2 id={slugify(block.text)}>{block.text}</h2>;
          if (block.type === 'quote')
            return (
              <blockquote>
                <p>{block.text}</p>
                <cite>{block.by}</cite>
              </blockquote>
            );
          if (block.type === 'ad')
            return (
              <div class="aprose__ad">
                <AdSlot format="leaderboard" />
              </div>
            );
          if (block.type === 'related')
            return <RelatedInline currentSlug={article.slug} rubrik={article.rubrik} />;
          return null;
        })}

        <!-- label & tag -->
        <footer class="aprose__foot">
          <div class="aprose__tags">
            {article.tags.map((t: string) => (
              <a href={`/arsip?tag=${encodeURIComponent(t)}`} class="tag">#{t}</a>
            ))}
          </div>
          <div class="aprose__endmark" aria-hidden="true">
            <span></span><span class="dot"></span><span></span>
          </div>
        </footer>

        <!-- kotak penulis -->
        <section class="abox">
          <div class="abox__initial">{article.author.charAt(0)}</div>
          <div class="abox__body">
            <span class="eyebrow">Penulis</span>
            <h3>{article.author}</h3>
            <p>
              {article.authorRole} di Swara Bestari. Menulis tentang {article.tags.join(', ').toLowerCase()},
              dan hal-hal yang berada di antara kategori.
            </p>
          </div>
        </section>

        <!-- diskusi -->
        <section class="adisc" id="diskusi">
          <div class="adisc__head">
            <span class="eyebrow">Ruang Diskursus</span>
            <h2>Bagaimana tulisan ini <em>pada Anda?</em></h2>
            <p>
              Kami membaca setiap tanggapan. Kirimkan koreksi, bantahan, atau catatan
              pinggir Anda—beberapa akan kami terbitkan di edisi berikutnya.
            </p>
          </div>
          <form class="adisc__form" id="discuss-form" novalidate>
            <div class="adisc__row">
              <label>
                <span>Nama</span>
                <input type="text" name="nama" placeholder="Nama Anda" required />
              </label>
              <label>
                <span>Surel (tidak diterbitkan)</span>
                <input type="email" name="surel" placeholder="alamat@surel.id" required />
              </label>
            </div>
            <label>
              <span>Tanggapan</span>
              <textarea name="pesan" rows="4" placeholder="Tulis tanggapan Anda…" required></textarea>
            </label>
            <div class="adisc__actions">
              <button type="submit" class="btn">Kirim tanggapan <span class="btn__arrow">→</span></button>
              <span class="adisc__note" id="discuss-note">Kami balas dalam 2–3 hari kerja.</span>
            </div>
          </form>
        </section>
      </article>

      <!-- rail kanan: iklan lengket -->
      <aside class="arail">
        <AdSlot format="halfpage" />
        <div class="arail__sticky">
          <AdSlot format="square" />
          <div class="arail__note">
            <span class="arail__note-eyebrow">Tentang iklan kami</span>
            <p>
              Kami tidak menerima iklan yang menyamar sebagai berita.
              Setiap konten bersponsor diberi label <strong>Mata Surat</strong>.
            </p>
            <a href="/iklan">Lihat media kit →</a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- ═════════ TERKAIT ═════════ -->
  <section class="arelated">
    <div class="wrap">
      <div class="arelated__head">
        <span class="eyebrow">Lanjutkan Membaca</span>
        <h2>Tulisan <em>terkait</em></h2>
      </div>
      <div class="arelated__grid">
        {rel.map((a, i) => (
          <ArticleCard article={a} variant="standard" />
        ))}
      </div>
      <div class="arelated__ad">
        <AdSlot format="strip" />
      </div>
    </div>
  </section>
</Base>

<script>
  /* ── simpan & riwayat ─────────────────────────────────── */
  const SLUG = (document.getElementById('save-btn') as HTMLElement)?.dataset.slug || '';
  const KEY_SAVED = 'sb-saved';
  const KEY_HIST = 'sb-history';
  const readLS = (k: string): any[] => {
    try { return JSON.parse(localStorage.getItem(k) || '[]'); } catch { return []; }
  };
  const writeLS = (k: string, v: any[]) => localStorage.setItem(k, JSON.stringify(v));

  // catat riwayat (unix ts, maks 40, unik per slug)
  if (SLUG) {
    const hist = readLS(KEY_HIST).filter((h: any) => h.slug !== SLUG);
    hist.unshift({ slug: SLUG, at: Date.now() });
    writeLS(KEY_HIST, hist.slice(0, 40));
  }

  // tombol simpan
  const saveBtn = document.getElementById('save-btn');
  if (saveBtn && SLUG) {
    const sync = () => {
      const on = readLS(KEY_SAVED).includes(SLUG);
      saveBtn.classList.toggle('is-saved', on);
      saveBtn.setAttribute('aria-pressed', String(on));
      saveBtn.setAttribute('aria-label', on ? 'Hapus dari simpanan' : 'Simpan tulisan');
    };
    sync();
    saveBtn.addEventListener('click', () => {
      let saved = readLS(KEY_SAVED);
      if (saved.includes(SLUG)) saved = saved.filter((x) => x !== SLUG);
      else saved.unshift(SLUG);
      writeLS(KEY_SAVED, saved);
      sync();
      // umpan balik halus
      saveBtn.classList.add('pop');
      setTimeout(() => saveBtn.classList.remove('pop'), 380);
    });
  }

  const form = document.getElementById('discuss-form') as HTMLFormElement | null;
  const note = document.getElementById('discuss-note');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!note) return;
    const data = new FormData(form);
    const nama = String(data.get('nama') || '').trim();
    const surel = String(data.get('surel') || '').trim();
    const pesan = String(data.get('pesan') || '').trim();
    if (!nama || !pesan || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(surel)) {
      note.textContent = 'Lengkapi nama, surel yang sah, dan tanggapan Anda.';
      note.style.color = '#a8553a';
      return;
    }
    note.textContent = 'Terima kasih. Tanggapan Anda sudah sampai ke meja redaksi.';
    note.style.color = 'var(--gold-700)';
    form.reset();
  });
</script>

<style>
  /* ── header ── */
  .ah {
    position: relative;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
    overflow: hidden;
    border-bottom: 1px solid var(--line-soft);
  }
  .ah__bg {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    pointer-events: none;
  }
  .ah__bg img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); }
  .ah__inner { position: relative; }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    font-family: var(--sans);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-700);
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .crumbs a:hover { color: var(--ink); }
  .crumbs span { opacity: 0.4; }
  .ah__title {
    font-family: var(--serif-display);
    font-size: clamp(2.2rem, 5.6vw, 4.4rem);
    font-weight: 500;
    line-height: 0.99;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .ah__sujudul {
    margin-top: 1.15rem;
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    line-height: 1.55;
    color: var(--muted);
    font-style: italic;
    max-width: 62ch;
  }
  .ah__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.75rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    font-family: var(--sans);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .ah__author {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .ah__initial {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--gold-100);
    border: 1px solid var(--gold);
    color: var(--gold-800);
    display: grid;
    place-items: center;
    font-family: var(--serif-display);
    font-size: 0.7rem;
  }
  .ah__dot { width: 3px; height: 3px; border-radius: 50%; background: var(--line); }

  /* ── hero image ── */
  .ahero { margin-bottom: clamp(2rem, 4vw, 3.25rem); }
  .ahero__frame {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .ahero__frame img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: saturate(0.94);
  }
  .ahero__cap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    color: var(--muted-2);
  }
  .ahero__credit { color: var(--gold-700); }

  /* ── tata letak ── */
  .awrap { max-width: 1280px; }
  .alayout {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 300px;
    gap: clamp(1.25rem, 3.5vw, 3rem);
    align-items: start;
  }

  /* ── berbagi ── */
  .ashare {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    position: sticky;
    top: 6.5rem;
  }
  .ashare__label {
    font-family: var(--sans);
    font-size: 0.5rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-2);
    writing-mode: vertical-rl;
    margin-bottom: 0.35rem;
  }
  .ashare__btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    display: grid;
    place-items: center;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background 0.35s var(--ease), color 0.35s, border-color 0.35s, transform 0.35s var(--ease-out);
  }
  .ashare__btn svg { width: 15px; height: 15px; }
  .ashare__btn:hover {
    background: var(--ink);
    color: var(--gold-200);
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  .ashare__btn--save { position: relative; }
  .ashare__saved {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--gold-600);
    color: var(--ivory);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.3s, transform 0.35s var(--ease-out);
    font-size: 0.8rem;
  }
  .ashare__btn--save.is-saved .ashare__saved { opacity: 1; transform: scale(1); }
  .ashare__btn--save.is-saved { border-color: var(--gold-600); color: transparent; }
  .ashare__btn--save.pop { animation: savePop 0.38s var(--ease-out); }
  @keyframes savePop {
    50% { transform: scale(1.16); }
  }

  /* ── prosa ── */
  .aprose {
    max-width: 68ch;
    margin-inline: auto;
    font-family: var(--serif-body);
    font-size: clamp(1.06rem, 1.15vw, 1.2rem);
    line-height: 1.78;
    color: var(--ink-2);
  }
  .aprose > p { margin-bottom: 1.5em; }
  .aprose > p + p { text-indent: 0; }
  .alede {
    font-family: var(--serif-display);
    font-size: clamp(1.25rem, 2vw, 1.6rem) !important;
    line-height: 1.45 !important;
    letter-spacing: -0.01em;
    color: var(--ink) !important;
    border-left: 2px solid var(--gold);
    padding-left: 1.25rem;
    margin-bottom: 2rem !important;
  }
  .aprose > p:first-of-type:not(.alede)::first-letter {
    font-family: var(--serif-display);
    font-size: 4.6em;
    line-height: 0.78;
    float: left;
    padding: 0.06em 0.1em 0 0;
    color: var(--gold-700);
    font-weight: 500;
  }
  .aprose h2 {
    font-family: var(--serif-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin-block: 2.25em 0.75em;
    color: var(--ink);
  }
  .aprose blockquote {
    margin-block: 2.25em;
    padding: 1.5rem 0 1.5rem 1.5rem;
    border-left: 1px solid var(--gold);
    position: relative;
  }
  .aprose blockquote p {
    font-family: var(--serif-display);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-style: italic;
    line-height: 1.32;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .aprose blockquote cite {
    display: block;
    margin-top: 0.9rem;
    font-family: var(--sans);
    font-size: 0.58rem;
    font-style: normal;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-700);
  }
  .aprose__ad { margin-block: 2.5em; }

  .aprose__foot {
    margin-top: 3em;
    padding-top: 1.5rem;
